---
// Concept C (Datasheet) applied to the CV page. Prototype only.
import Profile from "../../layouts/Profile.astro";
import { identity as id, loadProfile } from "../../data/profile";
const c = await loadProfile();
const range = (s?: string, e?: string) => [s, e].filter(Boolean).join(" – ");
---
<Profile title={`CV — ${id.name}`} description={`${id.role}, ${id.employer}. Experience, education and results.`} fonts="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;600&display=swap" noindex>
  <a class="skip" href="#main">Skip to content</a>
  <div class="sheet">
    <header class="top no-print">
      <a href="/proto/c" class="logo" aria-label="Back to homepage">KV</a>
      <button type="button" onclick="window.print()">Print / save PDF</button>
    </header>
    <main id="main">
      <header class="head">
        <div>
          <h1>{id.name}</h1>
          <p class="sub">{id.role} — {id.employer}</p>
        </div>
        <dl class="contact mono">
          <dt>Email</dt><dd><a href={`mailto:${id.email}`}>{id.email}</a></dd>
          <dt>LinkedIn</dt><dd><a href={id.linkedin}>linkedin.com/in/kostavukicevic</a></dd>
          <dt>GitHub</dt><dd><a href={id.github}>github.com/stcksmsh</a></dd>
          <dt>Location</dt><dd>{id.location}</dd>
        </dl>
      </header>

      <section class="block" aria-labelledby="x-h">
        <h2 id="x-h"><span class="n mono">1</span>Experience</h2>
        {c.experience.map((e, i) => (
          <article class={i === 0 ? "entry cur" : "entry"}>
            <p class="when mono">{range(e.start, e.end)}</p>
            <div><h3>{e.title}</h3><p class="org">{e.org}</p>{e.Body && <div class="body"><e.Body /></div>}</div>
          </article>
        ))}
      </section>

      <section class="block keep" aria-labelledby="e-h">
        <h2 id="e-h"><span class="n mono">2</span>Education</h2>
        {c.education.map((e) => (
          <article class="entry"><p class="when mono">{range(e.start, e.end)}</p><div><h3>{e.title}</h3><p class="org">{e.org}</p></div></article>
        ))}
      </section>

      <div class="cols keep">
        <section class="block" aria-labelledby="r-h">
          <h2 id="r-h"><span class="n mono">3</span>Competition results</h2>
          <table class="kv"><tbody>{c.awards.map((a) => <tr><td class="mono">{a.start}</td><th scope="row">{a.title}</th></tr>)}</tbody></table>
        </section>
        <section class="block" aria-labelledby="s-h">
          <h2 id="s-h"><span class="n mono">4</span>Specifications</h2>
          <dl class="spec">
            <dt>Skills</dt><dd>{c.skills.map((x) => x.title).join(", ")}</dd>
            <dt>Certifications</dt><dd>{c.certifications.map((x) => x.title).join("; ")}</dd>
          </dl>
        </section>
      </div>
    </main>
  </div>
</Profile>

<style is:global>
  :root { --paper: #fdfdfb; --bg: #e7e6e1; --ink: #111; --dim: #555; --hi: #ffd400; --blue: #0b4fb3; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.5 "Archivo", system-ui, sans-serif; }
  a { color: var(--blue); }
  :focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--ink); color: #fff; padding: 6px 10px; z-index: 9; }
  .sheet { max-width: 960px; margin: clamp(0px, 3vw, 40px) auto; background: var(--paper); border: 2px solid var(--ink); box-shadow: 10px 10px 0 var(--ink); }
  .top { display: flex; justify-content: space-between; align-items: center; padding: 10px 20px; border-bottom: 2px solid var(--ink); }
  .logo { background: var(--ink); color: var(--hi); font-weight: 900; padding: 2px 8px; text-decoration: none; letter-spacing: .04em; }
  .top button { font: 600 13px "JetBrains Mono", monospace; background: var(--hi); border: 0; padding: 4px 10px; cursor: pointer; }
  .head { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding: 28px clamp(16px, 3vw, 28px); border-bottom: 2px solid var(--ink); }
  h1 { font-size: clamp(40px, 7vw, 72px); line-height: .95; font-weight: 900; font-variation-settings: "wdth" 62; text-transform: uppercase; margin: 0; }
  .sub { font-weight: 600; margin: 8px 0 0; font-size: 18px; }
  .contact { display: grid; grid-template-columns: auto auto; gap: 2px 12px; margin: 0; font-size: 13px; align-self: end; }
  .contact dt { color: var(--dim); } .contact dd { margin: 0; }
  .block { padding: 20px clamp(16px, 3vw, 28px); border-bottom: 2px solid var(--ink); }
  h2 { font-size: 14px; text-transform: uppercase; letter-spacing: .08em; font-weight: 800; margin: 0 0 12px; display: flex; gap: 10px; align-items: baseline; }
  .n { background: var(--ink); color: #fff; padding: 0 6px; font-size: 12px; }
  .entry { display: grid; grid-template-columns: 11.5rem 1fr; gap: 0 20px; padding: 10px 0; border-bottom: 1px solid #bbb; break-inside: avoid; }
  .entry:last-child { border-bottom: 0; }
  .entry.cur { background: linear-gradient(90deg, var(--hi), transparent 60%); }
  .when { margin: 2px 0 0; font-size: 13px; }
  h3 { font-size: 17px; margin: 0; }
  .org { margin: 0; color: var(--dim); }
  .body p { margin: 6px 0 0; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; }
  .cols .block + .block { border-left: 2px solid var(--ink); }
  .kv { border-collapse: collapse; width: 100%; }
  .kv td, .kv th { text-align: left; padding: 5px 10px 5px 0; border-bottom: 1px solid #bbb; }
  .kv td { width: 4.5em; }
  .spec { display: grid; grid-template-columns: 8.5em 1fr; gap: 8px 12px; margin: 0; }
  .spec dt { font-weight: 700; } .spec dd { margin: 0; }
  @media (max-width: 640px) {
    .sheet { box-shadow: none; border-width: 0 0 2px; }
    .entry { grid-template-columns: 1fr; }
    .cols { grid-template-columns: 1fr; } .cols .block + .block { border-left: 0; }
  }
  @media print {
    @page { size: A4; margin: 12mm; }
    body { background: #fff; font-size: 10pt; }
    .no-print, .skip { display: none !important; }
    .sheet { margin: 0; box-shadow: none; max-width: none; }
    h2 { break-after: avoid; }
    .keep { break-inside: avoid; }
    .block { padding: 12pt 14pt; } .head { padding: 16pt 14pt; } .entry { padding: 6pt 0; }
    a { text-decoration: none; color: inherit; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
