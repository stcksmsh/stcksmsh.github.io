---
// Concept B — "Paper": the profile typeset as a mathematics paper.
// Subject link: olympiad mathematics background; projects become the bibliography.
import { identity as id, loadProtoContent } from "./_content";
const c = await loadProtoContent();
const range = (s?: string, e?: string) => [s, e].filter(Boolean).join(" – ");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="data:," />
  <title>{id.name} — Concept B: Paper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="runhead">
    <span class="sc">Vukićević</span>
    <nav aria-label="Primary">
      <a href="#s1">§1 Work</a>
      <a href="#refs">References</a>
      <a href={id.cv}>CV</a>
      <a href={`mailto:${id.email}`}>Correspondence</a>
    </nav>
  </header>

  <main id="main" class="page">
    <section class="title">
      <p class="journal mono">arXiv-style preprint · {id.location} · rev. 2026</p>
      <h1>{id.name}</h1>
      <p class="affil">{id.role}<sup>1</sup></p>
      <p class="aff-note"><sup>1</sup>{id.employer}</p>

      <div class="abstract">
        <h2 class="sc">Abstract</h2>
        <p>{id.intro.join(" ")} This document gives a constructive account of that claim, in four sections, with full references.</p>
      </div>
      <p class="kw"><em>Keywords —</em> Android, Kotlin, automotive infotainment, competitive mathematics, sound.</p>
      <p class="actions">
        <a class="cta" href={id.cv}>Full CV (printable)</a>
        <a href={`mailto:${id.email}`}>{id.email}</a>
        <a href={id.linkedin}>LinkedIn</a>
        <a href={id.github}>GitHub</a>
      </p>
    </section>

    <section id="s1">
      <h2><span class="num">1</span> Professional experience</h2>
      {c.experience.map((e, i) => (
        <article class="thm">
          <p class="thm-head"><span class="lbl">{i === 0 ? "Theorem" : "Lemma"} 1.{i + 1}</span> <span class="ttl">({e.title})</span></p>
          <aside class="margin mono">{range(e.start, e.end)}</aside>
          <p class="stmt"><em>Held at {e.org}, {range(e.start, e.end)}.</em></p>
          {e.Body && <div class="proof"><span class="sc">Proof.</span> <e.Body /><span class="qed" aria-label="end of proof">∎</span></div>}
        </article>
      ))}
    </section>

    <section id="s2">
      <h2><span class="num">2</span> Education</h2>
      {c.education.map((e) => (
        <article class="thm">
          <p class="thm-head"><span class="lbl">Definition 2.1</span> <span class="ttl">({e.title})</span></p>
          <aside class="margin mono">{range(e.start, e.end)}</aside>
          <p class="stmt"><em>{e.org}, {range(e.start, e.end)}.</em></p>
        </article>
      ))}
    </section>

    <section id="s3">
      <h2><span class="num">3</span> Results</h2>
      <p>The author's competition record is summarised in Table 1.</p>
      <table>
        <caption><span class="sc">Table 1.</span> Olympiad results.</caption>
        <thead><tr><th scope="col">Year</th><th scope="col">Result</th><th scope="col">Competition</th></tr></thead>
        <tbody>
          {c.awards.map((a) => (
            <tr><td class="mono">{a.start}</td><td>{a.title}</td><td>{a.org}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="remark"><span class="lbl">Remark 3.1.</span> Further training: {c.certifications.map((x) => x.title).join("; ")}. Core skills: {c.skills.map((x) => x.title).join(", ")}.</p>
    </section>

    {c.projects.length > 0 && (
      <section id="refs">
        <h2><span class="num">4</span> Selected works</h2>
        <p>Independent projects, cited below; each links to its own write-up and devlog.</p>
        <ol class="bib">
          {c.projects.map((p) => (
            <li>
              <span class="sc">K. Vukićević</span>, <a href={`/projects/${p.slug}`}><em>{p.title}</em></a>. {p.tagline} <span class="mono">[{p.stack.join(", ")}]</span>, {p.status}.
            </li>
          ))}
        </ol>
      </section>
    )}

    <footer class="corr">
      <p><span class="sc">Correspondence</span> — <a href={`mailto:${id.email}`}>{id.email}</a> · <a href={id.linkedin}>LinkedIn</a> · <a href={id.github}>GitHub</a> · <a href={id.cv}>CV</a></p>
      <p class="end" aria-hidden="true">∎</p>
    </footer>
  </main>
</body>
</html>

<style is:global>
  :root { --paper: #fbf8f1; --ink: #1b1a17; --dim: #6a655a; --red: #9b1c1c; --rule: #1b1a17; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 19px/1.6 "STIX Two Text", Georgia, serif; font-variant-numeric: oldstyle-nums; }
  a { color: var(--red); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: .74em; font-variant-numeric: normal; }
  .sc { font-variant: small-caps; letter-spacing: .04em; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--ink); color: var(--paper); padding: 6px 10px; }

  .runhead { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; max-width: 1080px; margin: 0 auto; padding: 18px 16px 10px; border-bottom: 1px solid var(--rule); font-size: 16px; }
  .runhead nav { display: flex; flex-wrap: wrap; gap: 4px 20px; justify-content: flex-end; }
  .runhead nav a { color: var(--ink); text-decoration: none; }
  .runhead nav a:hover { color: var(--red); }

  .page { max-width: 1080px; margin: 0 auto; padding: 0 16px 80px; display: grid; grid-template-columns: minmax(0, 40rem) 1fr; column-gap: 48px; }
  .page > * { grid-column: 1; }

  .title { text-align: center; grid-column: 1 / -1; max-width: 46rem; margin: 0 auto; padding: clamp(40px, 9vw, 110px) 0 24px; }
  .journal { color: var(--dim); text-transform: uppercase; letter-spacing: .14em; }
  h1 { font-weight: 600; font-size: clamp(44px, 7.4vw, 92px); line-height: 1; letter-spacing: -.015em; margin: 18px 0 14px; }
  .affil { font-size: 22px; margin: 0; } .aff-note { font-size: 16px; color: var(--dim); margin: 4px 0 36px; font-style: italic; }
  .abstract { text-align: justify; hyphens: auto; max-width: 36rem; margin: 0 auto; }
  .abstract h2 { text-align: center; font-size: 17px; font-weight: 700; margin: 0 0 6px; }
  .abstract p { margin: 0; font-size: 18px; }
  .kw { max-width: 36rem; margin: 14px auto 0; font-size: 16px; text-align: left; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; margin: 34px 0 0; font-size: 17px; }
  .actions .cta { background: var(--ink); color: var(--paper); text-decoration: none; padding: 8px 18px; }

  section { padding-top: 40px; }
  h2 { font-size: 24px; font-weight: 700; margin: 0 0 16px; }
  .num { display: inline-block; min-width: 1.6em; color: var(--red); }

  .thm { position: relative; margin: 0 0 22px; }
  .thm-head { margin: 0; }
  .lbl { font-weight: 700; }
  .ttl { font-style: normal; }
  .stmt { margin: 0; }
  .proof { margin-top: 6px; } .proof p { display: inline; margin: 0; } .proof p + p::before { content: ""; display: block; height: .6em; }
  .qed { float: right; }
  .margin { position: absolute; left: calc(100% + 48px); top: 4px; width: 15rem; color: var(--dim); border-left: 2px solid var(--red); padding-left: 10px; }

  table { width: 100%; border-collapse: collapse; font-size: 17px; margin: 14px 0; border-top: 2px solid var(--rule); border-bottom: 2px solid var(--rule); }
  caption { caption-side: top; text-align: left; padding-bottom: 6px; font-size: 16px; }
  th { text-align: left; font-weight: 600; border-bottom: 1px solid var(--rule); padding: 6px 10px 6px 0; }
  td { padding: 5px 10px 5px 0; vertical-align: top; }
  .remark { font-size: 17px; }

  .bib { padding-left: 2.2em; font-size: 17px; }
  .bib li { margin-bottom: 10px; padding-left: 4px; }
  .bib li::marker { content: "[" counter(list-item) "]  "; color: var(--red); }

  .corr { grid-column: 1; border-top: 1px solid var(--rule); margin-top: 48px; padding-top: 14px; font-size: 17px; }
  .end { text-align: right; font-size: 22px; margin: 0; }

  @media (max-width: 900px) {
    .page { display: block; }
    .margin { position: static; display: block; width: auto; margin: 2px 0 4px; }
    .runhead nav a:nth-child(-n+2) { display: none; }
    body { font-size: 18px; }
    .abstract { text-align: left; }
  }
</style>
