---
// Concept A — "Route": the career drawn as a transit line.
// Subject link: Belgrade, the navigation team at Rivian, the bus-ticketing project.
import { identity as id, loadProtoContent } from "./_content";
const c = await loadProtoContent();
const range = (s?: string, e?: string) => [s, e].filter(Boolean).join(" – ");
const yearOf = (s?: string) => s?.match(/\d{4}/)?.[0] ?? "";
// Stations along the hero line, oldest → newest.
const stations = [
  ...c.education.map((e) => ({ label: "ETF Belgrade", year: yearOf(e.start) })),
  ...[...c.experience].reverse().map((e) => ({ label: e.title.replace("Android Software Engineer", "Android SWE"), year: yearOf(e.start) })),
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="data:," />
  <title>{id.name} — Concept A: Route</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;800;900&family=Overpass+Mono:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="bar">
    <a href="/proto/a" class="sign"><span class="bullet" aria-hidden="true">K</span>{id.name}</a>
    <nav aria-label="Primary">
      <a href="#work">Work</a>
      <a href="#projects">Projects</a>
      <a href={id.cv} class="pill">CV</a>
      <a href={`mailto:${id.email}`} class="pill solid">Contact</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow mono">Line K · {id.location}</p>
        <h1>{id.name}</h1>
        <p class="role">{id.role}<br /><span>at {id.employer}</span></p>
        <p class="intro">{id.intro.join(" ")}</p>
        <div class="cta">
          <a class="btn" href={id.cv}>Read the CV →</a>
          <a class="btn ghost" href={`mailto:${id.email}`}>{id.email}</a>
        </div>
      </div>

      <figure class="map" aria-label="Career route">
        <ol class="stops">
          {stations.map((s, i) => (
            <li class={i === stations.length - 1 ? "now" : ""}><span class="mono">{s.year}</span>{s.label}</li>
          ))}
        </ol>
        <figcaption class="mono">Next stop → you decide</figcaption>
      </figure>
    </section>

    <section id="work" class="line" aria-labelledby="work-h">
      <h2 id="work-h"><span class="badge">1</span>Work</h2>
      <ol class="route">
        {c.experience.map((e, i) => (
          <li class={i === 0 ? "current" : ""}>
            <p class="when mono">{range(e.start, e.end)}</p>
            <div>
              <h3>{e.title}</h3>
              <p class="org">{e.org}</p>
              {e.Body && <div class="body"><e.Body /></div>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="line alt" aria-labelledby="edu-h">
      <h2 id="edu-h"><span class="badge b">2</span>Education &amp; results</h2>
      <ol class="route">
        {c.education.map((e) => (
          <li><p class="when mono">{range(e.start, e.end)}</p><div><h3>{e.title}</h3><p class="org">{e.org}</p></div></li>
        ))}
        {c.awards.map((a) => (
          <li class="minor"><p class="when mono">{a.start}</p><div><h3>{a.title}</h3><p class="org">{a.org}</p></div></li>
        ))}
      </ol>
      <p class="transfer mono">Also: {c.certifications.map((x) => x.title).join(" · ")} — Skills: {c.skills.map((x) => x.title).join(" · ")}</p>
    </section>

    {c.projects.length > 0 && (
      <section id="projects" class="interchange" aria-labelledby="proj-h">
        <h2 id="proj-h"><span class="badge c">⇄</span>Connections — things I build</h2>
        <ul>
          {c.projects.map((p) => (
            <li>
              <a href={`/projects/${p.slug}`}>
                <span class="plat mono">{p.status}</span>
                <h3>{p.title}</h3>
                <p>{p.tagline}</p>
                <span class="mono stack">{p.stack.join(" / ")}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="terminus" aria-labelledby="end-h">
      <h2 id="end-h">Terminus</h2>
      <p>Hiring, collaborating, or just curious — get in touch.</p>
      <ul class="mono">
        <li><a href={`mailto:${id.email}`}>{id.email}</a></li>
        <li><a href={id.linkedin}>LinkedIn</a></li>
        <li><a href={id.github}>GitHub</a></li>
        <li><a href={id.cv}>CV</a></li>
      </ul>
    </section>
  </main>
</body>
</html>

<style is:global>
  :root {
    --paper: #f3f0e8; --ink: #141414; --dim: #5b5850; --rule: #d8d3c6;
    --k: #e4471b; --b: #1d5bd8; --c: #0f8a5f;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 17px/1.55 "Overpass", system-ui, sans-serif; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--b); outline-offset: 3px; }
  .mono { font-family: "Overpass Mono", ui-monospace, monospace; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--ink); color: var(--paper); padding: 6px 10px; z-index: 9; }

  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px clamp(16px, 4vw, 48px); border-bottom: 6px solid var(--k); background: var(--ink); color: var(--paper); position: sticky; top: 0; z-index: 5; }
  .sign { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; letter-spacing: .01em; }
  .bullet { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--k); color: #fff; font-weight: 900; }
  .bar nav { display: flex; gap: clamp(8px, 2vw, 22px); align-items: center; font-weight: 600; }
  .bar nav a { text-decoration: none; }
  .pill { border: 2px solid currentColor; border-radius: 99px; padding: 3px 12px; }
  .pill.solid { background: var(--paper); color: var(--ink); border-color: var(--paper); }

  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(24px, 5vw, 80px); padding: clamp(32px, 7vw, 96px) clamp(16px, 4vw, 48px) 48px; max-width: 1240px; margin: 0 auto; }
  .eyebrow { color: var(--k); font-weight: 600; text-transform: uppercase; letter-spacing: .12em; font-size: 14px; margin: 0 0 12px; }
  h1 { font-size: clamp(48px, 8.5vw, 116px); line-height: .92; font-weight: 900; letter-spacing: -.035em; margin: 0 0 22px; }
  .role { font-size: clamp(19px, 2vw, 24px); font-weight: 800; margin: 0 0 22px; line-height: 1.25; }
  .role span { font-weight: 400; color: var(--dim); }
  .intro { max-width: 34em; font-size: 19px; margin: 0 0 30px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn { background: var(--ink); color: var(--paper); padding: 12px 20px; font-weight: 800; text-decoration: none; border-radius: 4px; }
  .btn.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 2px var(--ink); font-weight: 600; overflow-wrap: anywhere; }

  .hero > * { min-width: 0; }
  .map { margin: 0; align-self: center; }
  .stops { list-style: none; margin: 0; padding: 0 0 0 0; position: relative; }
  .stops::before { content: ""; position: absolute; left: 13px; top: 14px; bottom: -34px; width: 14px; border-radius: 7px; background: linear-gradient(var(--k) calc(100% - 40px), transparent 0), repeating-linear-gradient(var(--k) 0 4px, transparent 4px 12px); }
  .stops li { position: relative; padding: 0 0 34px 64px; font-weight: 800; font-size: 19px; line-height: 1.15; }
  .stops li::before { content: ""; position: absolute; left: 4px; top: 4px; width: 32px; height: 32px; box-sizing: border-box; border-radius: 50%; background: var(--paper); border: 6px solid var(--ink); }
  .stops li.now::before { background: var(--k); width: 40px; height: 40px; left: 0; top: 0; }
  .stops li.now { font-size: 24px; }
  .stops li span { display: block; font-size: 13px; font-weight: 600; color: var(--dim); }
  .map figcaption { padding: 34px 0 0 64px; color: var(--dim); font-size: 13px; }

  .line, .interchange, .terminus { max-width: 1240px; margin: 0 auto; padding: 56px clamp(16px, 4vw, 48px); border-top: 2px solid var(--ink); }
  h2 { display: flex; align-items: center; gap: 14px; font-size: clamp(28px, 4vw, 44px); font-weight: 900; letter-spacing: -.02em; margin: 0 0 32px; }
  .badge { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; background: var(--k); color: #fff; font-size: 24px; }
  .badge.b { background: var(--b); } .badge.c { background: var(--c); }
  .route { list-style: none; margin: 0; padding: 0; position: relative; }
  .route::before { content: ""; position: absolute; left: calc(9.5rem + 9px); top: 10px; bottom: 10px; width: 8px; background: var(--k); border-radius: 4px; }
  .alt .route::before { background: var(--b); }
  .route li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 0 48px; padding: 0 0 30px; position: relative; }
  .route li::before { content: ""; position: absolute; left: calc(9.5rem + 3px); top: 4px; width: 20px; height: 20px; border-radius: 50%; background: var(--paper); border: 4px solid var(--ink); box-sizing: border-box; }
  .route li.current::before { background: var(--k); width: 26px; height: 26px; left: calc(9.5rem); top: 1px; }
  .route li.minor h3 { font-size: 17px; }
  .when { margin: 2px 0 0; font-size: 14px; color: var(--dim); text-align: right; }
  .route h3 { margin: 0; font-size: 21px; font-weight: 800; line-height: 1.2; }
  .org { margin: 2px 0 0; color: var(--dim); }
  .body { max-width: 40em; margin-top: 10px; } .body p { margin: 0 0 10px; }
  .transfer { margin: 8px 0 0; font-size: 14px; color: var(--dim); }

  .interchange ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0; border-left: 2px solid var(--ink); border-top: 2px solid var(--ink); }
  .interchange li { border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .interchange a { display: block; height: 100%; padding: 20px; text-decoration: none; }
  .interchange a:hover { background: var(--ink); color: var(--paper); }
  .interchange h3 { margin: 8px 0 6px; font-size: 22px; font-weight: 900; }
  .interchange p { margin: 0 0 12px; font-size: 15px; }
  .plat { display: inline-block; background: var(--c); color: #fff; font-size: 12px; padding: 1px 8px; text-transform: uppercase; letter-spacing: .08em; }
  .stack { font-size: 12px; opacity: .75; }

  .terminus { background: var(--ink); color: var(--paper); max-width: none; border: 0; }
  .terminus > * { max-width: 1144px; margin-left: auto; margin-right: auto; }
  .terminus h2 { color: var(--k); }
  .terminus ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 18px; }

  @media (max-width: 760px) {
    .bar nav a:not(.pill) { display: none; }
    .sign { font-size: 15px; }
    .hero { grid-template-columns: 1fr; }
    .stops { display: flex; overflow-x: auto; padding: 0 0 4px; }
    .stops::before { left: 0; right: 0; top: 13px; bottom: auto; height: 10px; width: auto; background: var(--k); }
    .stops li { flex: none; padding: 40px 22px 0 0; font-size: 15px; }
    .stops li::before { left: 0; top: 2px; width: 32px; height: 32px; border-width: 5px; }
    .stops li.now { font-size: 15px; } .stops li.now::before { top: 0; width: 36px; height: 36px; }
    .map figcaption { padding: 8px 0 0; }
    .route::before { left: 9px; }
    .route li { grid-template-columns: 1fr; padding-left: 44px; }
    .route li::before { left: 3px; } .route li.current::before { left: 0; }
    .when { text-align: left; margin-bottom: 4px; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
