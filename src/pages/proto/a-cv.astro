---
// Concept A (Route) applied to the CV page. Prototype only.
import Profile from "../../layouts/Profile.astro";
import { identity as id, loadProfile } from "../../data/profile";
const c = await loadProfile();
const range = (s?: string, e?: string) => [s, e].filter(Boolean).join(" – ");
---
<Profile title={`CV — ${id.name}`} description={`${id.role}, ${id.employer}. Experience, education and results.`} fonts="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;800;900&family=Overpass+Mono:wght@400;600&display=swap" noindex>
  <a class="skip" href="#main">Skip to content</a>
  <header class="bar no-print">
    <a href="/proto/a" class="sign"><span class="bullet" aria-hidden="true">K</span>{id.name}</a>
    <button class="pill" type="button" onclick="window.print()">Print / save PDF</button>
  </header>
  <main id="main" class="cv">
    <header class="head">
      <div>
        <h1>{id.name}</h1>
        <p class="role">{id.role} · {id.employer}</p>
        <p class="loc mono">{id.location}</p>
      </div>
      <ul class="contact mono">
        <li><a href={`mailto:${id.email}`}>{id.email}</a></li>
        <li><a href={id.linkedin}>linkedin.com/in/kostavukicevic</a></li>
        <li><a href={id.github}>github.com/stcksmsh</a></li>
      </ul>
    </header>

    <section aria-labelledby="x-h">
      <h2 id="x-h"><span class="badge">1</span>Experience</h2>
      <ol class="route">
        {c.experience.map((e, i) => (
          <li class={i === 0 ? "current" : ""}>
            <p class="when mono">{range(e.start, e.end)}</p>
            <div><h3>{e.title}</h3><p class="org">{e.org}</p>{e.Body && <div class="body"><e.Body /></div>}</div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="e-h">
      <h2 id="e-h"><span class="badge b">2</span>Education</h2>
      <ol class="route b">
        {c.education.map((e) => (
          <li><p class="when mono">{range(e.start, e.end)}</p><div><h3>{e.title}</h3><p class="org">{e.org}</p></div></li>
        ))}
      </ol>
    </section>

    <div class="split keep">
      <section aria-labelledby="r-h">
        <h2 id="r-h"><span class="badge b">3</span>Results</h2>
        <ul class="plain">{c.awards.map((a) => <li><span class="mono">{a.start}</span> {a.title}<br /><small>{a.org}</small></li>)}</ul>
      </section>
      <section aria-labelledby="s-h">
        <h2 id="s-h"><span class="badge c">4</span>Skills &amp; certifications</h2>
        <ul class="plain">{c.skills.map((s) => <li>{s.title}</li>)}</ul>
        <ul class="plain">{c.certifications.map((s) => <li>{s.title}</li>)}</ul>
      </section>
    </div>
  </main>
</Profile>

<style is:global>
  :root { --paper: #f3f0e8; --ink: #141414; --dim: #5b5850; --k: #e4471b; --b: #1d5bd8; --c: #0f8a5f; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 16px/1.55 "Overpass", system-ui, sans-serif; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--b); outline-offset: 3px; }
  .mono { font-family: "Overpass Mono", ui-monospace, monospace; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--ink); color: var(--paper); padding: 6px 10px; z-index: 9; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px clamp(16px, 4vw, 48px); background: var(--ink); color: var(--paper); border-bottom: 6px solid var(--k); }
  .sign { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; }
  .bullet { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--k); color: #fff; font-weight: 900; }
  .pill { font: 600 15px "Overpass", sans-serif; color: var(--ink); background: var(--paper); border: 0; border-radius: 99px; padding: 6px 14px; cursor: pointer; }

  .cv { max-width: 920px; margin: 0 auto; padding: 40px clamp(16px, 4vw, 40px) 64px; }
  .head { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; border-bottom: 3px solid var(--ink); padding-bottom: 20px; margin-bottom: 28px; }
  h1 { font-size: clamp(40px, 6vw, 64px); line-height: .95; font-weight: 900; letter-spacing: -.03em; margin: 0 0 10px; }
  .role { font-weight: 800; margin: 0; font-size: 18px; }
  .loc { color: var(--dim); margin: 4px 0 0; font-size: 14px; }
  .contact { list-style: none; margin: 0; padding: 0; font-size: 14px; align-self: end; }
  h2 { display: flex; align-items: center; gap: 12px; font-size: 24px; font-weight: 900; margin: 28px 0 18px; }
  .badge { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--k); color: #fff; font-size: 17px; }
  .badge.b { background: var(--b); } .badge.c { background: var(--c); }
  .route { list-style: none; margin: 0; padding: 0; position: relative; }
  .route::before { content: ""; position: absolute; left: calc(8.5rem + 7px); top: 8px; bottom: 8px; width: 6px; background: var(--k); border-radius: 3px; }
  .route.b::before { background: var(--b); }
  .route li { display: grid; grid-template-columns: 8.5rem 1fr; gap: 0 40px; padding-bottom: 20px; position: relative; break-inside: avoid; }
  .route li::before { content: ""; position: absolute; left: calc(8.5rem + 2px); top: 4px; width: 16px; height: 16px; border-radius: 50%; background: var(--paper); border: 3px solid var(--ink); box-sizing: border-box; }
  .route li.current::before { background: var(--k); }
  .when { margin: 2px 0 0; font-size: 13px; color: var(--dim); text-align: right; }
  h3 { margin: 0; font-size: 18px; font-weight: 800; }
  .org { margin: 0; color: var(--dim); }
  .body p { margin: 8px 0 0; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .plain { list-style: none; padding: 0; margin: 0 0 12px; } .plain li { margin-bottom: 8px; }
  small { color: var(--dim); }
  @media (max-width: 640px) {
    .route::before { left: 7px; } .route li { grid-template-columns: 1fr; padding-left: 36px; } .route li::before { left: 2px; }
    .when { text-align: left; } .split { grid-template-columns: 1fr; gap: 0; }
  }
  @media print {
    @page { size: A4; margin: 14mm 14mm; }
    :root { --paper: #fff; }
    body { font-size: 10pt; }
    .keep { break-inside: avoid; }
    .route li { padding-bottom: 10pt; }
    .head { margin-bottom: 12pt; padding-bottom: 10pt; }
    .no-print, .skip { display: none !important; }
    .cv { padding: 0; max-width: none; }
    h1 { font-size: 30pt; } h2 { font-size: 14pt; margin: 14pt 0 8pt; break-after: avoid; }
    a { text-decoration: none; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
