---
// Concept B (Paper) applied to the CV page. Prototype only.
import Profile from "../../layouts/Profile.astro";
import { identity as id, loadProfile } from "../../data/profile";
const c = await loadProfile();
const range = (s?: string, e?: string) => [s, e].filter(Boolean).join(" – ");
---
<Profile title={`CV — ${id.name}`} description={`${id.role}, ${id.employer}. Experience, education and results.`} fonts="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" noindex>
  <a class="skip" href="#main">Skip to content</a>
  <header class="runhead no-print">
    <a href="/proto/b" class="sc">Vukićević</a>
    <button type="button" onclick="window.print()">Print / save PDF</button>
  </header>
  <main id="main" class="cv">
    <header class="title">
      <h1>{id.name}</h1>
      <p>{id.role}, {id.employer} · {id.location}</p>
      <p class="contact"><a href={`mailto:${id.email}`}>{id.email}</a> · <a href={id.linkedin}>linkedin.com/in/kostavukicevic</a> · <a href={id.github}>github.com/stcksmsh</a></p>
    </header>

    <section aria-labelledby="x-h">
      <h2 id="x-h"><span class="num">1</span> Experience</h2>
      {c.experience.map((e) => (
        <article class="entry">
          <div class="row"><h3>{e.title}</h3><span class="mono">{range(e.start, e.end)}</span></div>
          <p class="org"><em>{e.org}</em></p>
          {e.Body && <div class="body"><e.Body /></div>}
        </article>
      ))}
    </section>

    <section aria-labelledby="e-h">
      <h2 id="e-h"><span class="num">2</span> Education</h2>
      {c.education.map((e) => (
        <article class="entry">
          <div class="row"><h3>{e.title}</h3><span class="mono">{range(e.start, e.end)}</span></div>
          <p class="org"><em>{e.org}</em></p>
        </article>
      ))}
    </section>

    <section class="keep" aria-labelledby="r-h">
      <h2 id="r-h"><span class="num">3</span> Results</h2>
      <table>
        <caption><span class="sc">Table 1.</span> Olympiad results.</caption>
        <thead><tr><th scope="col">Year</th><th scope="col">Result</th><th scope="col">Competition</th></tr></thead>
        <tbody>{c.awards.map((a) => <tr><td class="mono">{a.start}</td><td>{a.title}</td><td>{a.org}</td></tr>)}</tbody>
      </table>
    </section>

    <section class="keep" aria-labelledby="s-h">
      <h2 id="s-h"><span class="num">4</span> Skills and certifications</h2>
      <p><span class="sc">Skills.</span> {c.skills.map((s) => s.title).join(", ")}.</p>
      <p><span class="sc">Certifications.</span> {c.certifications.map((s) => s.title).join("; ")}.</p>
    </section>
  </main>
</Profile>

<style is:global>
  :root { --paper: #fbf8f1; --ink: #1b1a17; --dim: #6a655a; --red: #9b1c1c; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 18px/1.55 "STIX Two Text", Georgia, serif; }
  a { color: var(--red); text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: .74em; }
  .sc { font-variant: small-caps; letter-spacing: .04em; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--ink); color: var(--paper); padding: 6px 10px; }
  .runhead { display: flex; justify-content: space-between; align-items: center; max-width: 820px; margin: 0 auto; padding: 16px; border-bottom: 1px solid var(--ink); }
  .runhead a { color: var(--ink); text-decoration: none; }
  .runhead button { font: inherit; font-size: 16px; background: var(--ink); color: var(--paper); border: 0; padding: 6px 14px; cursor: pointer; }
  .cv { max-width: 820px; margin: 0 auto; padding: 0 16px 64px; }
  .title { text-align: center; padding: 48px 0 20px; border-bottom: 1px solid var(--ink); }
  h1 { font-weight: 600; font-size: clamp(38px, 6vw, 60px); line-height: 1; margin: 0 0 12px; }
  .title p { margin: 4px 0; }
  .contact { font-size: 16px; }
  h2 { font-size: 22px; margin: 32px 0 12px; }
  .num { color: var(--red); display: inline-block; min-width: 1.4em; }
  .entry { margin-bottom: 16px; break-inside: avoid; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  h3 { font-size: 18px; font-weight: 700; margin: 0; }
  .row .mono { color: var(--dim); }
  .org { margin: 0; }
  .body p { margin: 6px 0 0; }
  table { width: 100%; border-collapse: collapse; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); font-size: 16px; }
  caption { caption-side: top; text-align: left; font-size: 15px; padding-bottom: 6px; }
  th { text-align: left; border-bottom: 1px solid var(--ink); padding: 4px 10px 4px 0; }
  td { padding: 4px 10px 4px 0; vertical-align: top; }
  @media print {
    @page { size: A4; margin: 16mm 16mm; }
    :root { --paper: #fff; --red: #111; }
    body { font-size: 10pt; }
    .keep { break-inside: avoid; }
    .no-print, .skip { display: none !important; }
    .cv { padding: 0; max-width: none; }
    .title { padding-top: 0; }
    h1 { font-size: 26pt; } h2 { font-size: 13pt; margin: 14pt 0 6pt; break-after: avoid; }
    a { text-decoration: none; color: inherit; }
  }
</style>
