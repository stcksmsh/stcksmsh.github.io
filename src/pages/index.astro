---
// Root homepage — "Datasheet" direction (owner-approved concept C, 2026-11-20):
// the profile laid out as an engineering component datasheet.
// Subject link: automotive embedded/Android engineering; brief's C4 "technical manual" reference.
// Career = revision history, olympiads = characterisation data, projects = application notes.
import Profile from "../layouts/Profile.astro";
import { identity as id, loadProfile, domains, toYear } from "../data/profile";
const c = await loadProfile();
const cv = "/cv";
const range = (s?: string, e?: string) => [s, e].filter(Boolean).join(" – ");
const yearOf = (s?: string) => s?.match(/\d{4}/)?.[0] ?? "";
const firstYear = yearOf(c.experience.at(-1)?.start);
// Revisions: oldest role = Rev A, current role = highest letter.
const rev = (i: number) => String.fromCharCode(65 + c.experience.length - 1 - i);

// Timeline ruler: every dated record, oldest → newest.
const events = [
  ...c.awards.map((a) => ({ t: toYear(a.start), label: a.title })),
  ...c.education.map((e) => ({ t: toYear(e.start), label: `Starts ${e.title} — ${e.org?.split(",")[0]}` })),
  ...c.experience.map((e) => ({ t: toYear(e.start), label: `${e.title} — ${e.org}` })),
].filter((e): e is { t: number; label: string } => e.t !== null).sort((a, b) => a.t - b.t)
  // Same-date records share one marker.
  .reduce<{ t: number; label: string }[]>((acc, e) => {
    const last = acc.at(-1);
    if (last && Math.abs(last.t - e.t) < 0.01) last.label += ` + ${e.label}`; else acc.push({ ...e });
    return acc;
  }, []);
const now = toYear("Present")!;
const t0 = Math.floor(events[0]?.t ?? now - 1);
const pos = (t: number) => ((t - t0) / (now - t0)) * 100;
const years = Array.from({ length: Math.floor(now) - t0 + 1 }, (_, i) => t0 + i);
const months = Math.round((now - t0) * 12);
const isAuto = (org?: string) => /rivian|volkswagen/i.test(org ?? "");
---
<Profile title={id.name} description={`${id.role}, ${id.employer}. Experience, education, selected work and contact.`} fonts="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;600&display=swap">
  <a class="skip" href="#main">Skip to content</a>
  <div class="sheet">
    <header class="top">
      <div class="maker"><span class="logo" aria-hidden="true">KV</span><span>{id.location}</span></div>
      <nav aria-label="Primary" class="mono">
        <a href="#rev">Revision history</a>
        <a href="#app">Applications</a>
        <a href={cv} class="hl">CV ↓</a>
        <a href={`mailto:${id.email}`} class="hl">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="title" aria-labelledby="name">
        <h1 id="name" aria-label={id.name}>{id.name.split(" ").map((w, wi) => (
          <span class="word" aria-hidden="true">{[...w].map((ch, ci) => <span class="ch" style={`--d:${wi * 6 + ci}`}>{ch}</span>)}</span>
        ))}</h1>
        <p class="sub">{id.role} — {id.employer}</p>
        <div class="pn mono">
          <span>Part no.</span><b>KV-SWE-II</b>
          <span>Status</span><b class="ok"><i class="led" aria-hidden="true"></i>In production</b>
          {firstYear && <><span>Since</span><b>{firstYear}</b></>}
        </div>
        <div class="ruler" style={`--m:${months}`} data-t0={t0} data-t1={now}>
          <div class="ticks" aria-hidden="true"></div>
          {years.map((y) => <span class="yr mono" aria-hidden="true" style={`left:${pos(y)}%`}>{y}</span>)}
          <ol class="evs" aria-label={`Timeline ${t0}–${Math.floor(now)}`}>
            {events.map((e) => (
              <li tabindex="0" style={`left:${pos(e.t)}%`} data-t={e.t} data-label={e.label}><span class="sr-only">{Math.floor(e.t)}: {e.label}</span></li>
            ))}
          </ol>
          <div class="head" aria-hidden="true"><span class="read mono"></span></div>
        </div>
      </section>

      <section class="cols reveal">
        <div class="block">
          <h2><span class="n mono">1</span>Features</h2>
          {/* Hand-condensed from: experience-1..4, award-1..5, federated project stacks.
              Re-check against src/content/cv when any of those change. */}
          <ul class="feat">
            <li>Software engineer shipping production code in automotive infotainment{firstYear && ` since ${firstYear}`}</li>
            <li>Generalist problem solver: picks the stack the problem needs — Rust, Python, TypeScript, Kotlin</li>
            <li>Mathematics olympiad background: IMO, BMO, IOI</li>
            <li>Builds constantly outside work: developer tools, creative coding, audio and web</li>
          </ul>
        </div>
        <div class="block">
          <h2><span class="n mono">2</span>Description</h2>
          <p class="desc">{id.intro.join(" ")}</p>
          <div class="cta">
            <a href={cv} class="btn">Download full CV</a>
            <a href={`mailto:${id.email}`} class="btn ghost">Email</a>
          </div>
        </div>
        <figure class="block fig" aria-labelledby="fig1">
          <figcaption id="fig1" class="mono">Figure 1. Pin configuration — select a pin to trace it through this page</figcaption>
          <div class="pkg">
            {[domains.slice(0, 4), domains.slice(4)].map((side, si) => (
              <ul class={`pins ${si ? "r" : "l"}`}>
                {side.map((d, k) => (
                  <li><button type="button" class="pin" data-domain={d.id} data-desc={d.desc} aria-pressed="false" style={`--i:${si * 4 + k}`}>
                    <span class="no mono" aria-hidden="true">{si ? 8 - k : k + 1}</span><span class="lbl mono">{d.label}</span><span class="trace" aria-hidden="true"></span>
                  </button></li>
                ))}
              </ul>
            ))}
            <div class="chip" aria-hidden="true"><span class="notch"></span><b>KV</b><span class="mono">SWE-II</span></div>
          </div>
          <p class="chip-read mono" aria-live="polite">8 pins, one engineer. Nothing here is single-purpose.</p>
        </figure>
      </section>

      <section id="rev" class="block wide reveal" aria-labelledby="rev-h">
        <h2 id="rev-h"><span class="n mono">3</span>Revision history</h2>
        <div class="tbl">
          <table>
            <thead><tr><th scope="col">Rev</th><th scope="col">Date</th><th scope="col">Role</th><th scope="col">Organisation</th><th scope="col">Notes</th></tr></thead>
            <tbody>
              {c.experience.map((e, i) => (
                <tr class={i === 0 ? "cur" : ""} data-domains={isAuto(e.org) ? "auto" : ""}>
                  <td class="mono">{rev(i)}</td>
                  <td class="mono nowrap">{range(e.start, e.end)}</td>
                  <th scope="row">{e.title}</th>
                  <td>{e.org}</td>
                  <td class="notes">{e.Body ? <details><summary>Read<span class="sr-only"> notes: {e.title}</span></summary><e.Body /></details> : "—"}</td>
                </tr>
              ))}
              {c.education.length > 0 && <tr class="sep"><th colspan="5" scope="colgroup">Education</th></tr>}
              {c.education.map((e) => (
                <tr class="edu" data-domains="math">
                  <td class="mono">—</td>
                  <td class="mono nowrap">{range(e.start, e.end)}</td>
                  <th scope="row">{e.title}</th>
                  <td>{e.org}</td>
                  <td>—</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="cols two reveal">
        <div class="block" aria-labelledby="char-h">
          <h2 id="char-h"><span class="n mono">4</span>Characterisation data</h2>
          <table class="kv">
            <caption class="mono">Table 4-1. Competition results</caption>
            <tbody>
              {c.awards.map((a) => (
                <tr data-domains="math"><td class="mono">{a.start}</td><th scope="row">{a.title}</th></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="block" aria-labelledby="spec-h">
          <h2 id="spec-h"><span class="n mono">5</span>Specifications</h2>
          <dl class="spec">
            {c.skills.map((g) => <><dt>{g.title}</dt><dd>{g.items.length ? g.items.join(" · ") : g.title}</dd></>)}
            <dt>Certifications</dt><dd>{c.certifications.map((x) => x.title).join(" · ")}</dd>
          </dl>
        </div>
      </section>

      {c.projects.length > 0 && (
        <section id="app" class="block wide reveal" aria-labelledby="app-h">
          <h2 id="app-h"><span class="n mono">6</span>Application notes — selected work</h2>
          <ol class="apps">
            {c.projects.map((p, i) => (
              <li data-domains={p.domains.join(" ")}>
                <span class="mono an">AN-{String(i + 1).padStart(2, "0")}</span>
                <a href={`/projects/${p.slug}`}><b>{p.title}</b></a>
                <span class="tag">{p.tagline}</span>
                <span class="mono st">{p.stack.join(" · ")}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section class="block wide order reveal" aria-labelledby="ord-h">
        <h2 id="ord-h"><span class="n mono">7</span>Ordering information</h2>
        <ul class="mono">
          <li><span>Email</span><a href={`mailto:${id.email}`}>{id.email}</a></li>
          <li><span>LinkedIn</span><a href={id.linkedin}>kostavukicevic</a></li>
          <li><span>GitHub</span><a href={id.github}>stcksmsh</a></li>
          <li><span>CV</span><a href={cv}>/cv — printable</a></li>
        </ul>
      </section>
    </main>
    <footer class="foot mono"><span>{id.name} · <a href="/projects">All projects</a> · <a href="/devlog">Devlog</a> · <a href="/music">Music</a></span><span>KV-SWE-II{c.experience.length > 0 && ` · Rev ${rev(0)}`}</span></footer>
  </div>
</Profile>

<script>
  const root = document.documentElement;
  root.classList.add("js");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Sections slide in as they enter the viewport.
  const reveals = document.querySelectorAll(".reveal");
  if (reduce || !("IntersectionObserver" in window)) reveals.forEach((el) => el.classList.add("in"));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.08 });
    reveals.forEach((el) => io.observe(el));
  }

  // Name: letters widen toward the pointer (variable-font width axis).
  const title = document.querySelector<HTMLElement>(".title");
  const chars = [...document.querySelectorAll<HTMLElement>("#name .ch")];
  if (title && !reduce && matchMedia("(pointer: fine)").matches) {
    let centers: { x: number; y: number }[] = [];
    let frame = 0;
    const measure = () => { centers = chars.map((c) => { const r = c.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; }); };
    title.addEventListener("pointerenter", measure);
    addEventListener("scroll", () => (centers = []), { passive: true });
    title.addEventListener("pointermove", (ev) => {
      if (!centers.length) measure();
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => chars.forEach((c, i) => {
        const d = Math.hypot(ev.clientX - centers[i].x, ev.clientY - centers[i].y);
        c.style.setProperty("--w", String(62 + 58 * Math.max(0, 1 - d / 300) ** 1.5));
      }));
    });
    title.addEventListener("pointerleave", () => { cancelAnimationFrame(frame); chars.forEach((c) => c.style.removeProperty("--w")); });
  }

  // Timeline ruler: a scan head; hover/focus reads out the nearest record.
  const ruler = document.querySelector<HTMLElement>(".ruler");
  if (ruler) {
    const head = ruler.querySelector<HTMLElement>(".head")!;
    const read = ruler.querySelector<HTMLElement>(".read")!;
    const evs = [...ruler.querySelectorAll<HTMLElement>(".evs li")];
    const t0 = Number(ruler.dataset.t0), t1 = Number(ruler.dataset.t1);
    const MONTHS = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];
    const show = (t: number, label?: string) => {
      ruler.classList.add("tracking");
      const p = Math.min(1, Math.max(0, (t - t0) / (t1 - t0)));
      head.style.left = `${p * 100}%`;
      head.classList.toggle("flip", p > 0.7);
      read.textContent = label ?? `${MONTHS[Math.min(11, Math.floor((t % 1) * 12))]} ${Math.floor(t)}`;
      evs.forEach((e) => e.classList.toggle("hit", e.dataset.label === label));
    };
    const at = (x: number) => {
      const r = ruler.getBoundingClientRect();
      const t = t0 + ((x - r.left) / r.width) * (t1 - t0);
      const near = evs.map((e) => ({ e, d: Math.abs(Number(e.dataset.t) - t) })).sort((a, b) => a.d - b.d)[0];
      if (near && near.d < 0.35) show(Number(near.e.dataset.t), `${Math.floor(Number(near.e.dataset.t))} · ${near.e.dataset.label}`);
      else show(t);
    };
    ruler.addEventListener("pointermove", (e) => at(e.clientX));
    ruler.addEventListener("pointerdown", (e) => at(e.clientX));
    ruler.addEventListener("pointerleave", () => { ruler.classList.remove("tracking"); evs.forEach((e) => e.classList.remove("hit")); });
    evs.forEach((e) => e.addEventListener("focus", () => show(Number(e.dataset.t), `${Math.floor(Number(e.dataset.t))} · ${e.dataset.label}`)));
    evs.forEach((e) => e.addEventListener("blur", () => ruler.classList.remove("tracking")));
  }

  // Pin configuration: select a domain, light up the matching records.
  const pins = [...document.querySelectorAll<HTMLButtonElement>(".pin")];
  const out = document.querySelector<HTMLElement>(".chip-read");
  const idle = out?.textContent ?? "";
  pins.forEach((pin) => pin.addEventListener("click", () => {
    const d = root.dataset.pin === pin.dataset.domain ? "" : pin.dataset.domain!;
    root.dataset.pin = d;
    pins.forEach((p) => p.setAttribute("aria-pressed", String(p.dataset.domain === d)));
    let n = 0;
    document.querySelectorAll<HTMLElement>("[data-domains]").forEach((el) => {
      const on = !!d && el.dataset.domains!.split(" ").includes(d);
      if (on) n++;
      el.classList.toggle("lit", on);
      el.classList.toggle("dim", !!d && !on);
    });
    if (out) out.textContent = d ? `${pin.dataset.desc} → ${n} record${n === 1 ? "" : "s"} lit below` : idle;
  }));
</script>

<style is:global>
  :root { --paper: #fdfdfb; --bg: #e7e6e1; --ink: #111; --dim: #5d5d5d; --line: #111; --hi: #ffd400; --blue: #0b4fb3; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.5 "Archivo", system-ui, sans-serif; font-variation-settings: "wdth" 100; }
  a { color: var(--blue); }
  :focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--ink); color: #fff; padding: 6px 10px; z-index: 9; }

  .sheet { max-width: 1180px; margin: clamp(0px, 3vw, 40px) auto; background: var(--paper); border: 2px solid var(--line); box-shadow: 10px 10px 0 var(--ink); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 20px; border-bottom: 2px solid var(--line); flex-wrap: wrap; }
  .maker { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .logo { background: var(--ink); color: var(--hi); font-weight: 900; padding: 2px 8px; font-variation-settings: "wdth" 125; letter-spacing: .04em; }
  .top nav { display: flex; gap: 6px 18px; flex-wrap: wrap; font-size: 13px; }
  .top nav a { color: var(--ink); text-decoration: none; }
  .top nav a.hl { background: var(--hi); padding: 2px 8px; font-weight: 600; }

  .title { padding: clamp(28px, 6vw, 72px) clamp(16px, 4vw, 40px) 0; position: relative; }
  .pn { display: grid; grid-template-columns: auto auto; gap: 2px 14px; font-size: 13px; position: absolute; right: clamp(16px, 4vw, 40px); top: clamp(28px, 6vw, 72px); border: 2px solid var(--line); padding: 8px 12px; }
  .pn span { color: var(--dim); } .pn .ok { background: var(--hi); padding: 0 4px; display: inline-flex; align-items: center; gap: 6px; }
  .led { width: 8px; height: 8px; border-radius: 50%; background: #1a9c4a; box-shadow: 0 0 0 0 #1a9c4a; animation: led 2.4s ease-out infinite; }
  @keyframes led { 0% { box-shadow: 0 0 0 0 rgba(26,156,74,.7); } 70%, 100% { box-shadow: 0 0 0 7px rgba(26,156,74,0); } }
  h1 { font-size: clamp(52px, 10.5vw, 148px); line-height: .95; font-weight: 900; font-variation-settings: "wdth" 62; text-transform: uppercase; letter-spacing: -.01em; margin: 0; }
  .word { display: block; white-space: nowrap; }
  .ch { display: inline-block; font-variation-settings: "wdth" var(--w, 62); transition: font-variation-settings .35s cubic-bezier(.2,.8,.2,1); animation: settle .9s cubic-bezier(.2,.8,.2,1) backwards; animation-delay: calc(var(--d) * 45ms); }
  @keyframes settle { from { font-variation-settings: "wdth" 125; opacity: 0; } to { font-variation-settings: "wdth" 62; opacity: 1; } }
  .sub { font-size: clamp(18px, 2.2vw, 26px); font-weight: 600; font-variation-settings: "wdth" 85; margin: 14px 0 0; }
  .ruler { position: relative; height: 46px; margin: 26px 0 0; border-bottom: 2px solid var(--line); touch-action: pan-y; cursor: crosshair; }
  .ticks { position: absolute; inset: auto 0 0 0; height: 10px; background: linear-gradient(90deg, var(--ink) 0 1px, transparent 1px) 0 0 / calc(100% / var(--m)) 100% repeat-x; }
  .yr { position: absolute; bottom: 0; height: 40px; border-left: 2px solid var(--ink); padding-left: 4px; font-size: 11px; line-height: 1; color: var(--dim); }
  .evs { list-style: none; margin: 0; padding: 0; }
  .evs li { position: absolute; bottom: 14px; width: 10px; height: 10px; margin-left: -5px; background: var(--hi); border: 2px solid var(--ink); transform: rotate(45deg); outline-offset: 4px; }
  .evs li.hit { background: var(--ink); }
  .head { position: absolute; top: -6px; bottom: -2px; left: 0; width: 2px; background: var(--blue); pointer-events: none; animation: sweep 16s ease-in-out infinite alternate; }
  .ruler.tracking .head { animation: none; }
  .read { position: absolute; top: -20px; left: 6px; white-space: nowrap; font-size: 11px; background: var(--blue); color: #fff; padding: 1px 6px; opacity: 0; transition: opacity .2s; }
  .head.flip .read { left: auto; right: 6px; }
  .ruler.tracking .read { opacity: 1; }
  @keyframes sweep { from { left: 0; } to { left: 100%; } }

  .cols { display: grid; grid-template-columns: 1fr 1fr 1.15fr; border-bottom: 2px solid var(--line); }
  .cols.two { grid-template-columns: 1fr 1fr; }
  .cols > .block + .block { border-left: 2px solid var(--line); }
  .block { padding: 22px clamp(16px, 3vw, 28px) 26px; margin: 0; }
  .wide { border-bottom: 2px solid var(--line); }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: .08em; font-weight: 800; margin: 0 0 14px; display: flex; gap: 10px; align-items: baseline; }
  .n { background: var(--ink); color: #fff; padding: 0 6px; font-size: 12px; }
  .feat { margin: 0; padding-left: 1.1em; } .feat li { margin-bottom: 8px; } .feat li::marker { content: "■  "; font-size: .7em; }
  .desc { margin: 0 0 18px; font-size: 17px; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn { background: var(--ink); color: #fff; padding: 9px 16px; text-decoration: none; font-weight: 700; }
  .btn.ghost { background: var(--hi); color: var(--ink); }
  .fig figcaption { font-size: 12px; color: var(--dim); margin-bottom: 12px; }
  .pkg { display: grid; grid-template-columns: 1fr minmax(74px, .7fr) 1fr; align-items: stretch; }
  .pins { list-style: none; margin: 0; padding: 10px 0; display: grid; gap: 8px; }
  .pin { width: 100%; display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 6px; background: none; border: 0; padding: 4px 0; cursor: pointer; color: var(--ink); font: inherit; text-align: left; }
  .pins.l { grid-column: 1; } .pins.r { grid-column: 3; } .chip { grid-column: 2; grid-row: 1; }
  .pins.r .pin { grid-template-columns: 1fr auto auto; }
  .pins.r .trace { order: -1; } .pins.r .no { order: 1; }
  .pin .no { font-size: 10px; color: var(--dim); }
  .pin .lbl { font-size: 12px; font-weight: 600; padding: 1px 4px; }
  .trace { position: relative; height: 2px; background: var(--ink); overflow: hidden; min-width: 16px; }
  .trace::after { content: ""; position: absolute; top: -2px; width: 10px; height: 6px; background: var(--hi); animation: pulse 2.6s linear infinite; animation-delay: calc(var(--i) * -.37s); }
  .pins.l .trace::after { left: -10px; animation-name: pulse-r; }
  .pins.r .trace::after { right: -10px; animation-name: pulse-l; }
  @keyframes pulse-r { to { transform: translateX(calc(100% + 140px)); } }
  @keyframes pulse-l { to { transform: translateX(calc(-100% - 140px)); } }
  .pin:hover .lbl, .pin[aria-pressed="true"] .lbl { background: var(--ink); color: var(--hi); }
  .pin[aria-pressed="true"] .trace { background: var(--blue); height: 3px; }
  .chip { position: relative; border: 2px solid var(--ink); background: var(--ink); color: var(--hi); display: grid; place-content: center; text-align: center; gap: 2px; }
  .chip b { font-size: 26px; font-weight: 900; font-variation-settings: "wdth" 125; line-height: 1; }
  .chip .mono { font-size: 10px; color: #ddd; }
  .notch { position: absolute; top: -2px; left: 50%; width: 20px; height: 10px; margin-left: -10px; border-radius: 0 0 10px 10px; background: var(--paper); border: 2px solid var(--ink); border-top: 0; }
  .chip-read { font-size: 12px; margin: 14px 0 0; min-height: 2.6em; color: var(--dim); }
  :root[data-pin]:not([data-pin=""]) .chip { animation: chip 1.2s ease-in-out infinite alternate; }
  @keyframes chip { to { box-shadow: 0 0 0 4px var(--hi); } }

  [data-domains] { transition: opacity .3s, background-color .3s; }
  .dim { opacity: .28; }
  .lit { background-color: rgba(255, 212, 0, .35) !important; }
  .js .reveal { transition: opacity .7s ease, transform .7s cubic-bezier(.2,.8,.2,1); }
  .js .reveal:not(.in) { opacity: 0; transform: translateY(24px); }
  #rev.in tbody tr { animation: row .5s both; }
  #rev.in tbody tr:nth-child(2) { animation-delay: .08s; } #rev.in tbody tr:nth-child(3) { animation-delay: .16s; }
