---
import Base from "../layouts/Base.astro";
import Oscilloscope from "../components/islands/Oscilloscope.tsx";
import { getCollection } from "astro:content";
import { musicEmbedSrc } from "../lib/embeds";

// Federated projects — may be empty on first run before manifest repos exist.
let projects: any[] = [];
try {
  const all = await getCollection("projects");
  projects = all
    .map((p) => p.data)
    .sort((a, b) => Number(b.featured) - Number(a.featured) || a.order - b.order);
} catch {}

// Home shows a condensed teaser — full catalog lives on /music.
const TEASER_COUNT = 3;
let tracks: any[] = [];
try {
  const all = await getCollection("music");
  tracks = all
    .map((t) => t.data)
    .sort((a, b) => (b.year ?? 0) - (a.year ?? 0))
    .slice(0, TEASER_COUNT);
} catch {}

const nav = [
  ["projects", "/#work"],
  ["devlog", "/devlog"],
  ["music", "/music"],
  ["cv", "/cv"],
];

// Signature hero track(s) — self-hosted so the hero canvas can react to real
// playback (SoundCloud/Bandcamp embeds are iframes and can't feed a Web
// Audio analyser). Add files to public/audio/ and an entry here; only the
// first is wired up for now. Empty by default until real files exist.
const heroTracks: { title: string; src: string }[] = [];
const heroTrack = heroTracks[0];
---
<Base title="Kosta Vukićević">
  <nav class="shell nav">
    <a href="/" class="mark">KOSTA<span class="mark-dot">.</span>VUKIĆEVIĆ</a>
    <ul>
      {nav.map(([label, href]) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>

  <header class="shell hero">
    <div class="hero-scope">
      <Oscilloscope
        client:load
        mode="lissajous"
        ratio={[3, 2]}
        height={480}
        audioSrc={heroTrack?.src}
        trackTitle={heroTrack?.title}
      />
    </div>
    <div class="hero-copy">
      <span class="eyebrow coord">SOFTWARE / SYSTEMS / SOUND</span>
      <h1>BUILD<br/><span class="thin">THE</span> <em>SIGNAL</em></h1>
      <p class="lede">
        I write <b>Kotlin for cars</b> for a living. In my own time I
        <b>make music</b>, <b>break things on purpose</b>, and once helped
        a couple hundred people <b>ride the bus for free</b>. Based in
        Belgrade.
      </p>
      <div class="status">
        <span>LOC: <b>BELGRADE</b></span>
        <span>ROLE: <b>SWE · ANDROID</b></span>
        <span>STACK: <b>KOTLIN / GO / REACT</b></span>
        <span class="live">{projects.length} PROJECTS ACTIVE</span>
      </div>
    </div>
  </header>

  <section class="shell" id="work" style="margin-top: 5rem;">
    <div class="section-head">
      <span class="coord">01 / WORK</span>
      <h2>Selected builds</h2>
    </div>

    {projects.length === 0 ? (
      <p class="empty coord">
        // no federated projects yet — push an <code>io-page</code> branch
        with a <code>meta.json</code> to any repo in the manifest
      </p>
    ) : (
      <ul class="cards">
        {projects.map((p) => (
          <li
            class="card"
            style={p.accent ? `--accent-l:${p.accent[0]};--accent-c:${p.accent[1]};--accent-h:${p.accent[2]};` : ""}
          >
            <a href={`/projects/${p.slug}`}>
              <span class="card-status coord">{p.status}</span>
              <h3>{p.title}</h3>
              <p class="card-tag">{p.tagline}</p>
              <ul class="stack">
                {p.stack.slice(0, 4).map((s: string) => <li>{s}</li>)}
              </ul>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="shell" id="sound" style="margin-top: 5rem;">
    <div class="section-head">
      <span class="coord">02 / SOUND</span>
      <h2>Selected sounds</h2>
      <a class="more" href="/music">all tracks →</a>
    </div>

    {tracks.length === 0 ? (
      <p class="empty coord">
        // no tracks yet — add entries to <code>src/content/music/*.json</code>
      </p>
    ) : (
      <ul class="tracks">
        {tracks.map((t) => (
          <li
            class="track"
            style={t.accent ? `--accent-l:${t.accent[0]};--accent-c:${t.accent[1]};--accent-h:${t.accent[2]};` : ""}
          >
            <div class="track-meta coord">
              <span>{t.source}</span>
              {t.year && <span>{t.year}</span>}
            </div>
            <h3>{t.title}</h3>
            <div class="track-embed">
              <iframe
                loading="lazy"
                width="100%"
                height={t.source === "soundcloud" ? 166 : 300}
                scrolling="no"
                frameborder="no"
                allow="autoplay"
                title={t.title}
                src={musicEmbedSrc(t)}
              />
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 0; position: sticky; top: 0; z-index: 10;
    backdrop-filter: blur(8px);
    background: color-mix(in oklch, var(--bg) 70%, transparent);
    border-bottom: var(--border);
  }
  .mark { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); color: var(--ink); letter-spacing: 0.02em; }
  .mark-dot { color: var(--accent); }
  .nav ul { display: flex; gap: 1.5rem; list-style: none; }
  .nav ul a { color: var(--ink-dim); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.1em; }
  .nav ul a:hover { color: var(--accent); }
  @media (max-width: 620px) {
    .nav ul { display: none; }
  }

  .hero { padding-top: clamp(2rem, 6vw, 6rem); }
  .hero-scope {
    border: var(--border); border-radius: var(--radius);
    background: var(--bg-sunken); overflow: hidden;
    box-shadow: 0 0 80px -30px var(--accent-glow);
  }
  .hero-copy { margin-top: 2rem; }
  .eyebrow {
    display: flex; align-items: center; gap: 0.9rem;
    color: var(--accent); letter-spacing: 0.22em; margin-bottom: 1.4rem;
  }
  .eyebrow::before { content: ""; width: 2.2rem; height: 2px; background: var(--accent); }
  .hero-copy h1 {
    font-size: var(--hero); line-height: 0.92; letter-spacing: -0.02em;
    text-transform: uppercase; margin: 0.5rem 0 1.5rem;
  }
  .hero-copy h1 .thin { font-weight: 400; color: var(--ink-dim); }
  .hero-copy h1 em { font-style: normal; color: var(--accent); }
  .lede { max-width: var(--measure); color: var(--ink-dim); font-size: var(--step-1); margin-bottom: 1.6rem; }
  .lede b { color: var(--ink); font-weight: 500; }

  .status {
    display: flex; flex-wrap: wrap; gap: 0; border: var(--border);
    font-family: var(--font-mono); font-size: var(--step--1); width: fit-content; max-width: 100%;
  }
  .status span { padding: 0.6rem 1rem; border-right: var(--border); color: var(--ink-dim); letter-spacing: 0.06em; white-space: nowrap; }
  .status span:last-child { border-right: 0; }
  .status span b { color: var(--accent); font-weight: 500; }
  .status .live { color: var(--accent-cyan); }
  .status .live::before { content: "● "; }

  .section-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2rem; }
  .section-head h2 { font-size: var(--step-2); }
  .section-head .more { margin-left: auto; color: var(--ink-dim); font-size: var(--step--1); }
  .section-head .more:hover { color: var(--accent); }

  .cards { list-style: none; display: grid; gap: var(--gap); grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .card {
    border: var(--border); border-radius: var(--radius); background: var(--bg-raise);
    transition: border-color 0.2s var(--ease-scope), box-shadow 0.2s var(--ease-scope), transform 0.2s var(--ease-scope);
  }
  .card:hover { border-color: var(--accent); box-shadow: 0 0 40px -20px var(--accent-glow); transform: translateY(-2px); }
  .card a { display: block; padding: 1.5rem; color: inherit; }
  .card a:hover { text-decoration: none; }
  .card-status { display: inline-block; color: var(--accent); margin-bottom: 0.75rem; }
  .card h3 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .card-tag { color: var(--ink-dim); font-size: var(--step--1); margin-bottom: 1rem; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .stack li { font-size: var(--step--1); color: var(--ink-faint); border: var(--border); padding: 0.1rem 0.5rem; border-radius: var(--radius); }

  .empty { display: block; padding: 2rem; border: 1px dashed var(--hairline); border-radius: var(--radius); }
  .empty code { color: var(--accent); }

  .tracks { list-style: none; display: grid; gap: var(--gap); grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
  .track {
    border: var(--border); border-radius: var(--radius); background: var(--bg-raise);
    padding: 1.5rem;
    transition: border-color 0.2s var(--ease-scope), box-shadow 0.2s var(--ease-scope);
  }
  .track:hover { border-color: var(--accent); box-shadow: 0 0 40px -20px var(--accent-glow); }
  .track-meta { display: flex; gap: 1rem; color: var(--accent); margin-bottom: 0.5rem; }
  .track h3 { font-size: var(--step-1); margin-bottom: 1rem; }
  .track-embed { border-radius: var(--radius); overflow: hidden; }
  .track-embed iframe { display: block; border: 0; }

  /* Player strip is rendered by the Oscilloscope React island, so these
     rules must be :global() — Astro's scoped-style attribute never reaches
     into client-hydrated island markup. */
  :global(.oscilloscope-player) {
    display: flex; align-items: center; gap: 1.1rem;
    border-top: var(--border); background: var(--bg-raise);
    padding: 0.9rem 1.1rem;
  }
  :global(.oscilloscope-playbtn) {
    width: 2.75rem; height: 2.75rem; flex-shrink: 0; border: 0; cursor: pointer;
    background: var(--accent); color: var(--bg); font-size: 1rem;
    display: grid; place-items: center; font-family: var(--font-mono);
    transition: transform 0.15s var(--ease-scope);
  }
  :global(.oscilloscope-playbtn:hover) { transform: scale(1.06); }
  :global(.oscilloscope-playbtn:active) { transform: scale(0.94); }
  :global(.oscilloscope-ptext) {
    font-family: var(--font-mono); font-size: var(--step--1); color: var(--ink-dim); letter-spacing: 0.05em;
  }
  :global(.oscilloscope-ptext b) {
    display: block; color: var(--ink); font-size: var(--step-0); letter-spacing: 0.02em; margin-bottom: 0.2rem;
  }
</style>
