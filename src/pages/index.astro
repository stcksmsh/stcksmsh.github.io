---
import Base from "../layouts/Base.astro";
import SintezaBackground from "../components/islands/SintezaBackground.tsx";
import { getCollection } from "astro:content";
import { musicEmbedSrc } from "../lib/embeds";

// Federated projects — may be empty on first run before manifest repos exist.
let projects: any[] = [];
try {
  const all = await getCollection("projects");
  projects = all
    .map((p) => p.data)
    .sort((a, b) => Number(b.featured) - Number(a.featured) || a.order - b.order);
} catch {}

// Home shows a condensed teaser — full catalog lives on /music.
const TEASER_COUNT = 6;
let tracks: any[] = [];
try {
  const all = await getCollection("music");
  tracks = all
    .map((t) => ({ id: t.id, ...t.data }))
    .sort((a, b) => (b.year ?? 0) - (a.year ?? 0))
    .slice(0, TEASER_COUNT);
} catch {}

// Cross-project devlog teaser — same federated data /devlog uses, condensed.
const DEVLOG_TEASER_COUNT = 6;
let devlogTeaser: any[] = [];
try {
  const projectsByslug = new Map(projects.map((p) => [p.slug, p]));
  const allDevlogs = await getCollection("devlogs", (e: any) => !e.data.draft);
  devlogTeaser = allDevlogs
    .map((entry: any) => {
      const project = projectsByslug.get(entry.data.project);
      const anchor = entry.id.replace(/\.md$/, "").replace(/\//g, "--");
      const excerpt = entry.body
        .replace(/^#.*$/m, "")
        .replace(/\[(.*?)\]\(.*?\)/g, "$1")
        .replace(/[#*`_>]/g, "")
        .replace(/\s+/g, " ")
        .trim()
        .slice(0, 120);
      return {
        id: entry.id,
        title: entry.data.title,
        date: entry.data.date,
        excerpt: excerpt.length === 120 ? excerpt + "…" : excerpt,
        href: `/projects/${entry.data.project}#${anchor}`,
        projectTitle: project?.title ?? entry.data.project,
        accent: project?.accent,
      };
    })
    .sort((a: any, b: any) => b.date.valueOf() - a.date.valueOf())
    .slice(0, DEVLOG_TEASER_COUNT);
} catch {}

const nav = [
  ["projects", "/#work"],
  ["music", "/#sound"],
  ["devlog", "/#devlog"],
  ["cv", "/cv"],
];
---
<Base title="Kosta Vukićević">
  <nav class="shell nav">
    <a href="/" class="mark">KOSTA<span class="mark-dot">.</span>VUKIĆEVIĆ</a>
    <ul>
      {nav.map(([label, href]) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>

  <header class="hero">
    <SintezaBackground client:load />
    <div class="hero-scrim"></div>
    <div class="shell hero-inner">
      <div class="hero-copy">
        <span class="eyebrow coord">SOFTWARE / SYSTEMS / SOUND</span>
        <h1>BUILD<br/><span class="thin">THE</span> <em>SIGNAL</em></h1>
        <p class="lede">
          I write <b>Kotlin for cars</b> for a living. In my own time I
          <b>make music</b>, <b>break things on purpose</b>, and once helped
          a couple hundred people <b>ride the bus for free</b>. Based in
          Belgrade.
        </p>
        <div class="status">
          <span>LOC: <b>BELGRADE</b></span>
          <span>ROLE: <b>SWE · ANDROID</b></span>
          <span>STACK: <b>KOTLIN / GO / REACT</b></span>
          <span class="live">{projects.length} PROJECTS ACTIVE</span>
        </div>
      </div>
    </div>
  </header>

  <section class="shell" id="work" style="margin-top: 5rem;">
    <div class="section-head">
      <span class="coord">01 / WORK</span>
      <h2><a href="/projects">Selected builds <span class="arrow">→</span></a></h2>
    </div>

    {projects.length === 0 ? (
      <p class="empty coord">
        // no federated projects yet — push an <code>io-page</code> branch
        with a <code>meta.json</code> to any repo in the manifest
      </p>
    ) : (
      <ul class="carousel cards">
        {projects.map((p) => (
          <li
            class="card"
            style={p.accent ? `--accent-l:${p.accent[0]};--accent-c:${p.accent[1]};--accent-h:${p.accent[2]};` : ""}
          >
            <a href={`/projects/${p.slug}`}>
              <span class="card-status coord">{p.status}</span>
              <h3>{p.title}</h3>
              <p class="card-tag">{p.tagline}</p>
              <ul class="stack">
                {p.stack.slice(0, 4).map((s: string) => <li>{s}</li>)}
              </ul>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="shell" id="sound" style="margin-top: 5rem;">
    <div class="section-head">
      <span class="coord">02 / SOUND</span>
      <h2><a href="/music">Selected sounds <span class="arrow">→</span></a></h2>
    </div>

    {tracks.length === 0 ? (
      <p class="empty coord">
        // no tracks yet — add entries to <code>src/content/music/*.json</code>
      </p>
    ) : (
      <ul class="carousel tracks">
        {tracks.map((t) => (
          <li
            class="track"
            style={t.accent ? `--accent-l:${t.accent[0]};--accent-c:${t.accent[1]};--accent-h:${t.accent[2]};` : ""}
          >
            <div class="track-meta coord">
              <span>{t.source}</span>
              {t.year && <span>{t.year}</span>}
            </div>
            <h3>{t.title}</h3>
            {t.source === "soundcloud" ? (
              <button
                type="button"
                class="track-play"
                data-track={JSON.stringify({
                  slug: t.id, title: t.title, embedId: t.embedId, accent: t.accent, envelope: t.envelope,
                })}
              >
                <span class="track-play-icon">▶</span>
                <span>Play{t.envelope ? " — reactive" : ""}</span>
              </button>
            ) : (
              <div class="track-embed">
                <iframe
                  loading="lazy"
                  width="100%"
                  height="300"
                  seamless
                  title={t.title}
                  src={musicEmbedSrc(t)}
                />
              </div>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="shell" id="devlog" style="margin-top: 5rem;">
    <div class="section-head">
      <span class="coord">03 / DEVLOG</span>
      <h2><a href="/devlog">What's shipping <span class="arrow">→</span></a></h2>
    </div>

    {devlogTeaser.length === 0 ? (
      <p class="empty coord">// no devlog entries yet</p>
    ) : (
      <ul class="carousel devlog-teaser">
        {devlogTeaser.map((e) => (
          <li
            class="dt-entry"
            style={e.accent ? `--accent-l:${e.accent[0]};--accent-c:${e.accent[1]};--accent-h:${e.accent[2]};` : ""}
          >
            <a href={e.href}>
              <div class="dt-meta coord">
                <span>{e.projectTitle}</span>
                <time datetime={e.date.toISOString()}>{e.date.toISOString().slice(0, 10)}</time>
              </div>
              <h3>{e.title}</h3>
              <p class="dt-excerpt">{e.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 0; position: sticky; top: 0; z-index: 10;
    backdrop-filter: blur(8px);
    background: color-mix(in oklch, var(--bg) 70%, transparent);
    border-bottom: var(--border);
  }
  .mark { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); color: var(--ink); letter-spacing: 0.02em; }
  .mark-dot { color: var(--accent); }
  .nav ul { display: flex; gap: 1.5rem; list-style: none; }
  .nav ul a { color: var(--ink-dim); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.1em; }
  .nav ul a:hover { color: var(--accent); }
  @media (max-width: 620px) {
    .nav ul { display: none; }
  }

  /* The СИНТЕЗА visualizer as the hero's background layer (SINTEZA_VIZ.md):
     full-bleed within .hero (deliberately NOT .shell-constrained, unlike
     every other section — a background reads as a background only if it
     isn't boxed in), copy on top. A scrim between the two keeps the
     headline legible through a busy build/drop even though the package
     already keeps its own palette low-contrast by design. */
  .hero {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  :global(canvas.sinteza-bg) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    display: block; z-index: 0;
  }
  .hero-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(180deg, transparent 0%, var(--bg) 96%),
      linear-gradient(90deg, color-mix(in oklch, var(--bg) 60%, transparent) 0%, transparent 60%);
  }
  .hero-inner { position: relative; z-index: 2; width: 100%; padding-block: clamp(2rem, 6vw, 4rem); }
  .hero-copy { margin-top: 0; }
  .eyebrow {
    display: flex; align-items: center; flex-wrap: wrap; row-gap: 0.4rem; gap: 0.9rem;
    color: var(--accent); letter-spacing: 0.22em; margin-bottom: 1.4rem;
  }
  .eyebrow::before { content: ""; width: 2.2rem; height: 2px; background: var(--accent); flex-shrink: 0; }
  .hero-copy h1 {
    font-size: var(--hero); line-height: 0.92; letter-spacing: -0.02em;
    text-transform: uppercase; margin: 0.5rem 0 1.5rem;
  }
  .hero-copy h1 .thin { font-weight: 400; color: var(--ink-dim); }
  .hero-copy h1 em { font-style: normal; color: var(--accent); }
  .lede { max-width: var(--measure); color: var(--ink-dim); font-size: var(--step-1); margin-bottom: 1.6rem; }
  .lede b { color: var(--ink); font-weight: 500; }

  .status {
    display: flex; flex-wrap: wrap; gap: 0; border: var(--border);
    font-family: var(--font-mono); font-size: var(--step--1); width: fit-content; max-width: 100%;
  }
  .status span { padding: 0.6rem 1rem; border-right: var(--border); color: var(--ink-dim); letter-spacing: 0.06em; white-space: nowrap; }
  .status span:last-child { border-right: 0; }
  .status span b { color: var(--accent); font-weight: 500; }
  .status .live { color: var(--accent-cyan); }
  .status .live::before { content: "● "; }

  .section-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2rem; }
  .section-head h2 { font-size: var(--step-2); }
  .section-head h2 a { color: var(--ink); text-decoration: none; }
  .section-head h2 a:hover { color: var(--accent); }
  .section-head h2 .arrow { color: var(--accent); }

  /* Horizontal scroll-snap carousel — shared shape for projects/music/devlog.
     Each section's own class (.cards/.tracks/.devlog-teaser) sets item width. */
  .carousel {
    display: flex; gap: var(--gap); list-style: none;
    overflow-x: auto; scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem; margin: 0 calc(var(--gap) * -1);
    padding-inline: var(--gap);
    scrollbar-width: thin; scrollbar-color: var(--hairline) transparent;
  }
  .carousel > li { scroll-snap-align: start; flex-shrink: 0; }

  .cards > li { width: min(320px, 85vw); }
  .card {
    height: 100%;
    border: var(--border); border-radius: var(--radius); background: var(--bg-raise);
    transition: border-color 0.2s var(--ease-scope), box-shadow 0.2s var(--ease-scope), transform 0.2s var(--ease-scope);
  }
  .card:hover { border-color: var(--accent); box-shadow: 0 0 40px -20px var(--accent-glow); transform: translateY(-2px); }
  .card a { display: block; height: 100%; padding: 1.5rem; color: inherit; }
  .card a:hover { text-decoration: none; }
  .card-status { display: inline-block; color: var(--accent); margin-bottom: 0.75rem; }
  .card h3 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .card-tag { color: var(--ink-dim); font-size: var(--step--1); margin-bottom: 1rem; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .stack li { font-size: var(--step--1); color: var(--ink-faint); border: var(--border); padding: 0.1rem 0.5rem; border-radius: var(--radius); }

  .empty { display: block; padding: 2rem; border: 1px dashed var(--hairline); border-radius: var(--radius); }
  .empty code { color: var(--accent); }

  .tracks > li { width: min(280px, 85vw); }
  .track {
    height: 100%;
    border: var(--border); border-radius: var(--radius); background: var(--bg-raise);
    padding: 1.5rem;
    transition: border-color 0.2s var(--ease-scope), box-shadow 0.2s var(--ease-scope);
  }
  .track:hover { border-color: var(--accent); box-shadow: 0 0 40px -20px var(--accent-glow); }
  .track-meta { display: flex; gap: 1rem; color: var(--accent); margin-bottom: 0.5rem; }
  .track h3 { font-size: var(--step-1); margin-bottom: 1rem; }
  .track-embed { border-radius: var(--radius); overflow: hidden; }
  .track-embed iframe { display: block; border: 0; }
  .track-play {
    display: flex; align-items: center; gap: 0.6rem; width: 100%;
    background: none; border: var(--border); border-radius: var(--radius);
    color: var(--ink); font-family: var(--font-mono); font-size: var(--step--1);
    padding: 0.7rem 1rem; cursor: pointer; letter-spacing: 0.04em;
    transition: border-color 0.15s var(--ease-scope), color 0.15s var(--ease-scope);
  }
  .track-play:hover { border-color: var(--accent); color: var(--accent); }
  .track-play-icon { color: var(--accent); }

  .devlog-teaser > li { width: min(300px, 85vw); }
  .dt-entry {
    height: 100%;
    border: var(--border); border-radius: var(--radius); background: var(--bg-raise);
    transition: border-color 0.2s var(--ease-scope), box-shadow 0.2s var(--ease-scope);
  }
  .dt-entry:hover { border-color: var(--accent); box-shadow: 0 0 40px -20px var(--accent-glow); }
  .dt-entry a { display: block; height: 100%; padding: 1.5rem; color: inherit; }
  .dt-entry a:hover { text-decoration: none; }
  .dt-meta { display: flex; justify-content: space-between; gap: 0.75rem; color: var(--accent); margin-bottom: 0.6rem; }
  .dt-entry h3 { font-size: var(--step-0); margin-bottom: 0.5rem; }
  .dt-excerpt { color: var(--ink-dim); font-size: var(--step--1); }
</style>

<script>
  import { requestPlay } from "../lib/player-bus";
  // View Transitions re-run page scripts on every client-side navigation —
  // guard against stacking duplicate listeners on repeat visits home.
  if (!(window as any).__trackPlayBound) {
    (window as any).__trackPlayBound = true;
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(".track-play");
      if (!btn) return;
      const data = JSON.parse(btn.getAttribute("data-track")!);
      requestPlay(data);
    });
  }
</script>
