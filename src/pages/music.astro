---
import Base from "../layouts/Base.astro";
import Oscilloscope from "../components/islands/Oscilloscope.tsx";
import { getCollection } from "astro:content";
import { musicEmbedSrc } from "../lib/embeds";

let tracks: any[] = [];
try {
  const all = await getCollection("music");
  tracks = all
    .map((t) => ({ id: t.id, ...t.data }))
    .sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
} catch {}

const nav = [
  ["projects", "/#work"],
  ["music", "/#sound"],
  ["devlog", "/#devlog"],
  ["cv", "/cv"],
];
---
<Base title="Music — Kosta Vukićević" description="Tracks, embeds, and the oscilloscope work behind them.">
  <nav class="shell nav">
    <a href="/" class="mark">KOSTA<span class="mark-dot">.</span>VUKIĆEVIĆ</a>
    <ul>
      {nav.map(([label, href]) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>

  <header class="shell music-hero">
    <div class="music-scope">
      <Oscilloscope client:load mode="wave" height={360} />
    </div>
    <div class="hero-copy">
      <span class="coord">02 / SIGNAL</span>
      <h1>Music</h1>
      <p class="lede">
        SoundCloud tracks play through the bar at the bottom of the page —
        pick one here, keep browsing, it stays with you. Bandcamp releases
        stay embedded below since there's no way to control those from here.
      </p>
    </div>
  </header>

  <section class="shell" id="tracks" style="margin-top: 3rem;">
    {tracks.length === 0 ? (
      <p class="empty coord">
        // no tracks yet — add entries to <code>src/content/music/*.json</code>
      </p>
    ) : (
      <ul class="tracks">
        {tracks.map((t) => (
          <li
            class="track"
            style={t.accent ? `--accent-l:${t.accent[0]};--accent-c:${t.accent[1]};--accent-h:${t.accent[2]};` : ""}
          >
            <div class="track-meta coord">
              <span>{t.source}</span>
              {t.year && <span>{t.year}</span>}
            </div>
            <h3>{t.title}</h3>
            {t.source === "soundcloud" ? (
              <button
                type="button"
                class="track-play"
                data-track={JSON.stringify({
                  slug: t.id, title: t.title, embedId: t.embedId, accent: t.accent, envelope: t.envelope,
                })}
              >
                <span class="track-play-icon">▶</span>
                <span>Play{t.envelope ? " — reactive" : ""}</span>
              </button>
            ) : (
              <div class="track-embed">
                <iframe
                  loading="lazy"
                  width="100%"
                  height="300"
                  seamless
                  title={t.title}
                  src={musicEmbedSrc(t)}
                />
              </div>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: clamp(0.75rem, 2vw, 1.5rem);
    padding: 0.9rem clamp(1rem, 3vw, 1.75rem);
    position: relative; z-index: 3;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    border: var(--border);
    border-radius: var(--radius-panel);
    box-shadow: var(--panel-highlight), var(--panel-shadow);
  }
  .mark { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); color: var(--ink); letter-spacing: 0.02em; }
  .mark-dot { color: var(--accent); }
  .nav ul { display: flex; gap: 1.5rem; list-style: none; }
  .nav ul a { color: var(--ink-dim); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.1em; }
  .nav ul a:hover { color: var(--accent); }
  @media (max-width: 620px) {
    .nav ul { display: none; }
  }

  .music-hero { padding-top: clamp(2rem, 6vw, 6rem); }
  .music-scope {
    border: var(--border); border-radius: var(--radius-panel);
    background: var(--bg-sunken); overflow: hidden;
    box-shadow: var(--panel-highlight), 0 0 80px -30px var(--accent-glow);
  }
  .hero-copy { margin-top: 2rem; }
  .hero-copy h1 { font-size: var(--step-3); margin: 0.5rem 0 1rem; }
  .lede { max-width: var(--measure); color: var(--ink-dim); font-size: var(--step-1); }

  .tracks { list-style: none; display: grid; gap: var(--gap); grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .track {
    border: var(--border); border-radius: var(--radius-panel); background: var(--bg-glass);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    padding: 1.5rem;
    box-shadow: var(--panel-highlight), var(--panel-shadow);
    transition: border-color 0.2s var(--ease-scope), box-shadow 0.2s var(--ease-scope);
  }
  .track:hover { border-color: var(--accent); box-shadow: var(--panel-highlight), 0 0 40px -20px var(--accent-glow); }
  .track-meta { display: flex; gap: 1rem; color: var(--accent); margin-bottom: 0.5rem; }
  .track h3 { font-size: var(--step-1); margin-bottom: 1rem; }
  .track-embed { border-radius: var(--radius); overflow: hidden; }
  .track-embed iframe { display: block; border: 0; }

  .track-play {
    display: flex; align-items: center; gap: 0.6rem; width: 100%;
    background: none; border: var(--border); border-radius: var(--radius);
    color: var(--ink); font-family: var(--font-mono); font-size: var(--step--1);
    padding: 0.7rem 1rem; cursor: pointer; letter-spacing: 0.04em;
    transition: border-color 0.15s var(--ease-scope), color 0.15s var(--ease-scope);
  }
  .track-play:hover { border-color: var(--accent); color: var(--accent); }
  .track-play-icon { color: var(--accent); }

  .empty { display: block; padding: 2rem; border: 1px dashed var(--hairline); border-radius: var(--radius); }
  .empty code { color: var(--accent); }
</style>

<script>
  import { requestPlay } from "../lib/player-bus";
  // View Transitions re-run page scripts on every client-side navigation —
  // guard against stacking duplicate listeners on repeat visits to /music.
  if (!(window as any).__trackPlayBound) {
    (window as any).__trackPlayBound = true;
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(".track-play");
      if (!btn) return;
      const data = JSON.parse(btn.getAttribute("data-track")!);
      requestPlay(data);
    });
  }
</script>
