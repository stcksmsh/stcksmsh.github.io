---
// Homepage "board" skin (preview, not yet the live homepage).
// The profile drawn as a printed circuit board: the KV chip's pins are the domains,
// each project/record is a part wired to the pins it uses, contact links are the
// board's edge-connector fingers. Same paper/ink/yellow family as the datasheet CV.
import Profile from "../layouts/Profile.astro";
import { identity as id, loadProfile, domains } from "../data/profile";
import { buildBoard, type Layout, type PartInput, type Board } from "../lib/board";

const c = await loadProfile();
const range = (s?: string, e?: string) => [s, e].filter(Boolean).join(" – ");
const yearOf = (s?: string) => s?.match(/\d{4}/)?.[0] ?? "";
const firstWorkYear = yearOf(c.experience.at(-1)?.start);
const cur = c.experience[0];

const parts: PartInput[] = [
  ...(c.experience.length ? [{
    id: "work", ref: "J1", kind: "conn" as const, title: "WORK", sub: `${firstWorkYear}–NOW · ${c.experience.length} REVS`, href: "#work",
    domains: ["auto", "android"], detail: `${cur.title} — ${cur.org}`,
  }] : []),
  ...(c.awards.length ? [{
    id: "results", ref: "Y1", kind: "xtal" as const, title: "OLYMPIADS", sub: "IMO · BMO · IOI", href: "#results",
    domains: ["math"], detail: c.awards.map((a) => a.title).join(" · "),
  }] : []),
  ...c.education.map((e, i) => ({
    id: `edu-${i}`, ref: `U${20 + i}`, kind: "ic" as const, title: "ETF BELGRADE", sub: "SOFTWARE ENG.", href: "#work",
    domains: ["math", "systems"], detail: `${e.title} — ${e.org} (${range(e.start, e.end)})`,
  })),
  ...c.projects.map((p, i) => ({
    id: `p-${p.slug}`, ref: `U${i + 2}`, kind: "ic" as const, title: p.title.toUpperCase(), sub: p.status.toUpperCase(), href: p.url ?? `/projects/${p.slug}`,
    domains: p.domains, detail: `${p.tagline}  [${p.stack.join(" · ")}]`,
  })),
];
const fingers = [
  { label: "EMAIL", href: `mailto:${id.email}` },
  { label: "LINKEDIN", href: id.linkedin },
  { label: "GITHUB", href: id.github },
  { label: "CV", href: "/cv" },
];

const wide: Layout = {
  w: 1600, h: 1120,
  chip: { x: 800, y: 560, w: 350, h: 300 },
  slots: { l: [{ x: 250, y: 520 }, { x: 250, y: 690 }, { x: 250, y: 860 }], r: [{ x: 1350, y: 330 }, { x: 1350, y: 500 }, { x: 1350, y: 670 }, { x: 1350, y: 840 }], b: [{ x: 470, y: 1000 }, { x: 1130, y: 1000 }] },
  part: { w: 210, h: 96 },
  lanes: { l: [570, 390], r: [1030, 1210] },
  bottomLaneY: [790, 880],
  fingers: { y: 1055, x0: 660, x1: 940, h: 45, wire: true },
};
const narrow: Layout = {
  w: 420, h: 330 + Math.ceil(parts.length / 2) * 150 + 140,
  chip: { x: 210, y: 150, w: 250, h: 220 },
  slots: { l: [], r: [], b: parts.map((_, i) => ({ x: i % 2 ? 300 : 120, y: 390 + Math.floor(i / 2) * 150 })) },
  part: { w: 154, h: 84 },
  lanes: { l: [38, 14], r: [382, 406] },
  maxPads: 1,
  bottomLaneY: [0, 0],
  fingers: { y: 330 + Math.ceil(parts.length / 2) * 150 + 70, x0: 20, x1: 400, h: 50, wire: false },
  mode: "stack",
};
const boards: [string, Board][] = [["wide", buildBoard(wide, domains, parts, fingers)], ["narrow", buildBoard(narrow, domains, parts, fingers)]];
const partBy = Object.fromEntries(parts.map((p) => [p.id, p]));
---
<Profile title={`${id.name} — board`} description={`${id.role}, ${id.employer}. Experience, education, selected work and contact.`} fonts="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;600;700&display=swap" noindex>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="maker"><span class="logo" aria-hidden="true">KV</span><span>{id.location}</span></div>
    <nav aria-label="Primary" class="mono">
      <a href="#work">Work</a>
      <a href="#selected">Projects</a>
      <a href="/cv" class="hl">CV</a>
      <a href={`mailto:${id.email}`} class="hl">Contact</a>
    </nav>
  </header>

  <main id="main">
    <section class="stage" aria-labelledby="name">
      <div class="silk">
        <p class="eyebrow mono">REV {String.fromCharCode(64 + c.experience.length)} · {id.location.toUpperCase()}</p>
        <h1 id="name" aria-label={id.name}>{id.name.split(" ").map((w, wi) => (
          <span class="word" aria-hidden="true">{[...w].map((ch, ci) => <span class="ch" style={`--d:${wi * 6 + ci}`}>{ch}</span>)}</span>
        ))}</h1>
        <p class="role">{id.role} · {id.employer}</p>
        <p class="intro">{id.intro.join(" ")}</p>
      </div>

      <div class="probe mono" aria-live="polite">
        <span class="probe-h">PROBE</span>
        <b class="probe-t">Hover or tab to a part.</b>
        <span class="probe-d">Every part on this board is wired to the domains it uses. Click one to open it.</span>
      </div>

      {boards.map(([key, b]) => (
        <svg class={`board ${key}`} viewBox={`0 0 ${b.w} ${b.h}`} role="group" aria-label="Circuit board: parts are projects and records, wired to the domains they use">
          <defs>
            <pattern id={`grid-${key}`} width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="10" cy="10" r="1" class="dot" /></pattern>
          </defs>
          <rect class="pcb" x="6" y="6" width={b.w - 12} height={b.h - 12} rx="26" />
          <rect x="6" y="6" width={b.w - 12} height={b.h - 12} rx="26" fill={`url(#grid-${key})`} />
          {[[40, 40], [b.w - 40, 40], [40, b.h - 40], [b.w - 40, b.h - 40]].map(([x, y]) => <g class="hole" aria-hidden="true"><circle cx={x} cy={y} r="13" /><circle cx={x} cy={y} r="6" /></g>)}

          <g class="traces" aria-hidden="true">
            {b.traces.map((t, i) => (
              <g class="trace" data-net={t.net} data-part={t.part}>
                <path class="hit" d={t.d} />
                <path class="cu" d={t.d} pathLength="1" style={`--i:${i}`} />
                {t.vias.map(([x, y]) => <circle class="via" cx={x} cy={y} r="5" />)}
                <circle class="pulse" r={key === "wide" ? 4.5 : 3.5}>
                  <animateMotion dur={`${2.6 + (i % 5) * 0.45}s`} begin={`${(i * 0.37) % 3}s`} repeatCount="indefinite" path={t.d} />
                </circle>
              </g>
            ))}
            {b.fingers.map((f, i) => (
              <g class="trace" data-net="io"><path class="cu" d={f.d} pathLength="1" style={`--i:${b.traces.length + i}`} />
                <circle class="pulse" r="4"><animateMotion dur="3.2s" begin={`${i * 0.8}s`} repeatCount="indefinite" path={f.d} /></circle></g>
            ))}
          </g>

          <g class="chip" aria-hidden="true">
            <rect x={b.chip.x - b.chip.w / 2} y={b.chip.y - b.chip.h / 2} width={b.chip.w} height={b.chip.h} rx="6" />
            <circle class="pin1" cx={b.chip.x - b.chip.w / 2 + 18} cy={b.chip.y - b.chip.h / 2 + 18} r="6" />
            <text class="chip-kv" x={b.chip.x} y={b.chip.y + (key === "wide" ? 14 : 10)}>KV</text>
            <text class="chip-sub" x={b.chip.x} y={b.chip.y + (key === "wide" ? 40 : 30)}>SWE-II</text>
          </g>

          <g class="pins">
            {b.pins.map((p, i) => {
              const pw = key === "wide" ? 104 : 88, ph = key === "wide" ? 30 : 24, gap = key === "wide" ? 12 : 8;
              const bx = p.side === "l" ? p.x + gap : p.x - gap - pw;
              const num = p.side === "l" ? i + 1 : 8 - (i - 4);
              const n = b.parts.filter((q) => q.domains.includes(p.id)).length;
              return (
                <g class="pin" data-net={p.id} tabindex="0" role="button" aria-label={`Net ${p.label}: ${n} part${n === 1 ? "" : "s"}`}>
                  <line class="leg" x1={p.x} x2={p.side === "l" ? p.x - 14 : p.x + 14} y1={p.y} y2={p.y} />
                  <line class="bond" x1={p.x} x2={p.side === "l" ? bx : bx + pw} y1={p.y} y2={p.y} />
                  <rect class="pad-box" x={bx} y={p.y - ph / 2} width={pw} height={ph} rx="3" />
                  <text class="pin-no" x={p.side === "l" ? bx + 7 : bx + pw - 7} y={p.y + 4} text-anchor={p.side === "l" ? "start" : "end"}>{num}</text>
                  <text class="pin-lbl" x={p.side === "l" ? bx + (key === "wide" ? 24 : 20) : bx + pw - (key === "wide" ? 24 : 20)} y={p.y + 4} text-anchor={p.side === "l" ? "start" : "end"}>{p.label}</text>
                </g>
              );
            })}
          </g>

          {b.parts.map((p) => (
            <a class={`part ${p.kind}`} href={p.href} data-part={p.id} data-nets={p.domains.join(" ")} aria-label={`${p.ref} ${partBy[p.id].title}: ${p.detail}`}>
              <rect class="body" x={p.x - p.w / 2} y={p.y - p.h / 2} width={p.w} height={p.h} rx={p.kind === "xtal" ? p.h / 2 : 4} />
              {p.pads.map((pad) => <rect class="pad" x={pad.x - 7} y={pad.y - 7} width="14" height="14" />)}
              {p.kind === "conn" && [0, 1, 2, 3].map((k) => <circle class="hdr" cx={p.x - p.w / 2 + 30 + k * ((p.w - 60) / 3)} cy={p.y + p.h / 2 - (key === "wide" ? 16 : 10)} r={key === "wide" ? 6 : 4} />)}
              <text class="ref" x={p.x - p.w / 2 + (p.kind === "xtal" ? 30 : 12)} y={p.y - p.h / 2 + 20}>{p.ref}</text>
              <text class="ttl" x={p.x - p.w / 2 + (p.kind === "xtal" ? 30 : 12)} y={p.y + 6}>{p.title}</text>
              <text class="sub" x={p.x - p.w / 2 + (p.kind === "xtal" ? 30 : 12)} y={p.y + (p.kind === "conn" ? 22 : 28)}>{p.sub}</text>
            </a>
          ))}

          {b.fingers.map((f) => (
            <a class="finger" href={f.href} aria-label={f.label === "CV" ? "CV (printable)" : f.label === "EMAIL" ? `Email ${id.email}` : f.label}>
              <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="3" />
              <text x={f.x + f.w / 2} y={f.y + f.h / 2 + 5}>{f.label}</text>
            </a>
          ))}
          {key === "wide" && <text class="silk-note" x={b.w - 70} y={b.h - 64} text-anchor="end" aria-hidden="true">KV-SWE-II · MADE IN BELGRADE</text>}
        </svg>
      ))}
    </section>

    <section class="sheet" aria-label="Profile">
      <div class="block" id="work">
        <h2><span class="n mono">1</span>Work</h2>
        <ol class="rows">
          {c.experience.map((e, i) => (
            <li class={i === 0 ? "cur" : ""}><span class="mono when">{range(e.start, e.end)}</span><span><b>{e.title}</b><br /><span class="org">{e.org}</span></span></li>
          ))}
        </ol>
        <a class="more mono" href="/cv">Full CV with details →</a>
      </div>
      <div class="block" id="results">
        <h2><span class="n mono">2</span>Education &amp; results</h2>
        <ol class="rows">
          {c.education.map((e) => <li><span class="mono when">{range(e.start, e.end)}</span><span><b>{e.title}</b><br /><span class="org">{e.org}</span></span></li>)}
          {c.awards.map((a) => <li><span class="mono when">{a.start}</span><span><b>{a.title}</b></span></li>)}
        </ol>
      </div>
      <div class="block">
        <h2><span class="n mono">3</span>Skills</h2>
        <dl class="spec">{c.skills.map((g) => <><dt>{g.title}</dt><dd>{g.items.join(" · ")}</dd></>)}</dl>
      </div>
    </section>

    {c.projects.length > 0 && (
      <section class="sheet one" id="selected" aria-labelledby="sel-h">
        <div class="block">
          <h2 id="sel-h"><span class="n mono">4</span>Selected work</h2>
          <ol class="apps">
            {c.projects.map((p, i) => (
              <li data-part={`p-${p.slug}`}><span class="mono an">U{i + 2}</span><a href={p.url ?? `/projects/${p.slug}`}><b>{p.title}</b></a><span class="tag">{p.tagline}</span><span class="mono st">{p.stack.join(" · ")}</span></li>
            ))}
          </ol>
        </div>
      </section>
    )}
  </main>
  <footer class="foot mono"><span>{id.name} · <a href={`mailto:${id.email}`}>{id.email}</a> · <a href={id.linkedin}>LinkedIn</a> · <a href={id.github}>GitHub</a> · <a href="/cv">CV</a></span><span><a href="/projects">All projects</a> · <a href="/devlog">Devlog</a> · <a href="/music">Music</a></span></footer>
</Profile>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce) document.querySelectorAll<SVGSVGElement>("svg.board").forEach((s) => s.pauseAnimations());

  // Name letters widen toward the pointer (Archivo's width axis).
  const stage = document.querySelector<HTMLElement>(".stage");
  const chars = [...document.querySelectorAll<HTMLElement>("#name .ch")];
  if (stage && !reduce && matchMedia("(pointer: fine)").matches) {
    let centers: { x: number; y: number }[] = [];
    let frame = 0;
    const measure = () => { centers = chars.map((c) => { const r = c.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; }); };
    addEventListener("scroll", () => (centers = []), { passive: true });
    addEventListener("resize", () => (centers = []));
    stage.addEventListener("pointermove", (ev) => {
      if (!centers.length) measure();
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => chars.forEach((c, i) => {
        const d = Math.hypot(ev.clientX - centers[i].x, ev.clientY - centers[i].y);
        c.style.setProperty("--w", String(62 + 58 * Math.max(0, 1 - d / 300) ** 1.5));
      }));
    });
    stage.addEventListener("pointerleave", () => chars.forEach((c) => c.style.removeProperty("--w")));
  }

  // Probe: hovering/focusing a part lights its nets; hovering a trace names its net.
  const probeT = document.querySelector<HTMLElement>(".probe-t")!;
  const probeD = document.querySelector<HTMLElement>(".probe-d")!;
  const idleT = probeT.textContent, idleD = probeD.textContent;
  const labels: Record<string, string> = Object.fromEntries([...document.querySelectorAll<SVGGElement>(".pin")].map((p) => [p.dataset.net!, p.querySelector(".pin-lbl")!.textContent!.trim()]));
  const clear = () => {
    document.querySelectorAll(".on, .off").forEach((el) => el.classList.remove("on", "off"));
    document.body.classList.remove("probing");
    probeT.textContent = idleT; probeD.textContent = idleD;
  };
  const light = (match: (el: HTMLElement | SVGElement) => boolean) => {
    document.body.classList.add("probing");
    document.querySelectorAll<SVGElement>(".trace, .pin, .part").forEach((el) => {
      const on = match(el);
      el.classList.toggle("on", on); el.classList.toggle("off", !on);
    });
  };
  document.querySelectorAll<SVGAElement>(".part").forEach((part) => {
    const show = () => {
      const nets = part.dataset.nets!.split(" ");
      light((el) => el === part || (el as SVGElement).dataset.part === part.dataset.part || (el.classList.contains("pin") && nets.includes((el as SVGElement).dataset.net!)));
      const [head, ...rest] = part.getAttribute("aria-label")!.split(": ");
      probeT.textContent = head;
      probeD.textContent = `${rest.join(": ")}  ⟶ nets: ${nets.map((n) => labels[n] ?? n).join(", ")}`;
    };
    part.addEventListener("pointerenter", show);
    part.addEventListener("focus", show);
    part.addEventListener("pointerleave", clear);
    part.addEventListener("blur", clear);
  });
  // A net (one chip pin + its traces + the parts on it) lights from the pin pad or any of its traces.
  const showNet = (net: string) => {
    light((el) => (el as SVGElement).dataset.net === net || ((el as SVGElement).classList.contains("part") && (el as SVGElement).dataset.nets!.split(" ").includes(net)));
    const names = [...new Set([...document.querySelectorAll<SVGAElement>("svg.board:not([hidden]) .part.on")].filter((p) => p.getClientRects().length).map((p) => p.getAttribute("aria-label")!.split(":")[0].replace(/^\S+\s/, "")))];
    probeT.textContent = `NET ${labels[net] ?? net}`;
    probeD.textContent = names.length ? `On this net: ${names.join(", ")}` : "Nothing on this net yet.";
  };
  document.querySelectorAll<SVGGElement>(".trace[data-part], .pin").forEach((t) => {
    t.addEventListener("pointerenter", () => showNet(t.dataset.net!));
    t.addEventListener("pointerleave", clear);
  });
  document.querySelectorAll<SVGGElement>(".pin").forEach((p) => {
    p.addEventListener("focus", () => showNet(p.dataset.net!));
    p.addEventListener("blur", clear);
  });
</script>

<style is:global>
  :root { --paper: #fdfdfb; --bg: #e7e6e1; --ink: #111; --dim: #5d5d5d; --hi: #ffd400; --blue: #0b4fb3; --pcb: #f6f4ec; --dotc: #d9d5c6; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.5 "Archivo", system-ui, sans-serif; }
  a { color: var(--blue); }
  :focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 16px; top: 8px; background: var(--ink); color: #fff; padding: 6px 10px; z-index: 9; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px clamp(16px, 3vw, 32px); background: var(--paper); border-bottom: 2px solid var(--ink); position: sticky; top: 0; z-index: 5; }
  .maker { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .logo { background: var(--ink); color: var(--hi); font-weight: 900; padding: 2px 8px; font-variation-settings: "wdth" 125; }
  .top nav { display: flex; gap: 6px 18px; flex-wrap: wrap; font-size: 13px; }
  .top nav a { color: var(--ink); text-decoration: none; }
  .top nav a.hl { background: var(--hi); padding: 2px 8px; font-weight: 600; }

  /* Board stage */
  .stage { position: relative; max-width: 1600px; margin: clamp(0px, 2vw, 28px) auto 0; padding: 0 clamp(0px, 2vw, 28px); container-type: inline-size; }
  .board { display: block; width: 100%; height: auto; }
  .board.narrow { display: none; }
  .pcb { fill: var(--pcb); stroke: var(--ink); stroke-width: 3; }
  .dot { fill: var(--dotc); }
  .hole circle:first-child { fill: none; stroke: var(--ink); stroke-width: 2; } .hole circle:last-child { fill: var(--bg); stroke: var(--ink); stroke-width: 1.5; }
  .silk-note { font: 600 13px "JetBrains Mono", monospace; fill: var(--dim); letter-spacing: .1em; }

  .silk { position: absolute; left: calc(clamp(0px, 2vw, 28px) + 4.4cqw); top: 3.4cqw; width: 46cqw; pointer-events: none; z-index: 2; }
  .silk a, .silk h1 { pointer-events: auto; }
  .eyebrow { font-size: max(11px, .8cqw); letter-spacing: .14em; color: var(--dim); margin: 0 0 .4cqw; }
  h1 { font-size: 7.6cqw; line-height: .9; font-weight: 900; text-transform: uppercase; margin: 0; }
  .word { display: block; white-space: nowrap; }
  .ch { display: inline-block; font-variation-settings: "wdth" var(--w, 62); transition: font-variation-settings .35s cubic-bezier(.2,.8,.2,1); animation: settle .9s cubic-bezier(.2,.8,.2,1) backwards; animation-delay: calc(var(--d) * 45ms); }
  @keyframes settle { from { font-variation-settings: "wdth" 125; opacity: 0; } }
  .role { font-weight: 700; font-variation-settings: "wdth" 85; font-size: max(15px, 1.35cqw); margin: .9cqw 0 0; }
  .intro { font-size: max(14px, 1.05cqw); max-width: 34em; margin: .6cqw 0 0; color: #333; }

  .probe { position: absolute; right: calc(clamp(0px, 2vw, 28px) + 4cqw); top: 3.4cqw; width: 30cqw; z-index: 2; background: var(--ink); color: #eee; padding: 10px 14px; font-size: max(11px, .8cqw); display: grid; gap: 4px; box-shadow: 6px 6px 0 var(--hi); }
  .probe-h { color: var(--hi); letter-spacing: .14em; font-weight: 700; }
  .probe-t { color: #fff; font-size: 1.15em; }
  .probe-d { color: #bbb; min-height: 3em; }

  .cu { fill: none; stroke: #2a2a2a; stroke-width: 2.6; stroke-linejoin: round; stroke-dasharray: 1; animation: draw 1.4s cubic-bezier(.6,0,.2,1) backwards; animation-delay: calc(.4s + var(--i) * 45ms); transition: stroke .2s, opacity .2s, stroke-width .2s; }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  .hit { fill: none; stroke: transparent; stroke-width: 16; pointer-events: stroke; }
  .via { fill: var(--pcb); stroke: var(--ink); stroke-width: 2.5; }
  .pulse { fill: var(--hi); stroke: var(--ink); stroke-width: 1.5; }

  .chip rect { fill: var(--ink); }
  .pin1 { fill: #444; }
  .chip-kv { font: 900 52px "Archivo", sans-serif; font-variation-settings: "wdth" 125; fill: var(--hi); text-anchor: middle; }
  .chip-sub { font: 600 15px "JetBrains Mono", monospace; fill: #bbb; text-anchor: middle; letter-spacing: .1em; }
  .narrow .chip-kv { font-size: 30px; } .narrow .chip-sub { font-size: 11px; }
  .pin { cursor: crosshair; }
  .pin .leg { stroke: var(--ink); stroke-width: 6; }
  .pin .bond { stroke: #777; stroke-width: 1.5; }
  .pin .pad-box { fill: #222; stroke: #555; stroke-width: 1.5; transition: fill .2s, stroke .2s; }
  .pin .pin-no { font: 600 10px "JetBrains Mono", monospace; fill: #888; }
  .pin .pin-lbl { font: 700 13px "JetBrains Mono", monospace; fill: #eee; letter-spacing: .04em; }
  .narrow .pin .pin-lbl { font-size: 10.5px; } .narrow .pin .pin-no { font-size: 9px; }
