---
// Bespoke page for MOUTHPIECE — Astro resolves this static route in
// preference to the dynamic [slug].astro for this exact path, so this one
// project gets a custom layout while every other project keeps the generic
// template untouched.
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import MouthpieceDemoScope from "../../components/islands/MouthpieceDemoScope.tsx";
import { padForTicker } from "../../lib/ticker";

const projectEntry = await getEntry("projects", "mouthpiece");
if (!projectEntry) {
  throw new Error("mouthpiece project not federated — run `npm run federate` first");
}
const project = projectEntry.data;

const allDevlogs = await getCollection(
  "devlogs",
  (entry) => entry.data.project === "mouthpiece" && !entry.data.draft
);
const devlogs = allDevlogs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rendered = await Promise.all(
  devlogs.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const nav = [
  ["projects", "/projects"],
  ["music", "/music"],
  ["devlog", "/devlog"],
  ["cv", "/cv"],
];

const stats: [string, string][] = [
  ["words indexed", "165,425"],
  ["syllables", "195,011"],
  ["phones", "491,964"],
];

const tiers = [
  {
    n: "01",
    title: "whole word",
    body: "The exact word was spoken somewhere in the corpus — use that clip directly. Most natural, when it's available.",
  },
  {
    n: "02",
    title: "phrase reuse",
    body: "Consecutive words were spoken together in one recording — reuse that whole span as one continuous clip. Real co-articulation, no seam.",
  },
  {
    n: "03",
    title: "syllable stitch",
    body: "Split the word into syllables, search for the same natural continuity between them where it exists, splice what's left from unrelated clips.",
  },
  {
    n: "04",
    title: "phoneme fallback",
    body: "No syllable shape exists anywhere in the corpus — fall all the way down to individual phones. Rougher, but it makes almost any word constructible.",
  },
];
---
<Base title={project.title} description={project.tagline} accent={project.accent}>
  <nav class="shell nav">
    <a href="/" class="mark">KOSTA<span class="mark-dot">.</span>VUKIĆEVIĆ</a>
    <ul>
      {nav.map(([label, href]) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>

  <header class="project-hero">
    <div class="project-hero-scrim"></div>
    <div class="shell project-hero-inner">
      <span class="coord">{project.status}</span>
      <h1>{project.title}</h1>
      <p class="lede">{project.tagline}</p>
      <div class="ticker-viewport" aria-hidden="true">
        <ul class="stack">
          {[...padForTicker(project.stack), ...padForTicker(project.stack)].map((s: string | null) =>
            s === null ? <li class="ticker-gap" /> : <li>{s}</li>
          )}
        </ul>
      </div>
      <div class="project-links">
        <a href={project.repo}>repo →</a>
        {project.demo && <a href={project.demo}>demo →</a>}
      </div>

      <div class="mp-demo-shell">
        <span class="coord mp-demo-kicker">type a word — hear it built from real people's real words</span>
        <MouthpieceDemoScope client:visible slug="mouthpiece" accent={project.accent} />
      </div>
    </div>
  </header>

  <section class="shell" id="how-it-works">
    <div class="section-head">
      <span class="coord">02 / HOW IT WORKS</span>
      <h2>Four ways to build a word</h2>
    </div>
    <ol class="tiers">
      {tiers.map((t) => (
        <li class="tier">
          <span class="tier-n coord">{t.n}</span>
          <div>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <ul class="stat-line">
      {stats.map(([label, value]) => (
        <li><b>{value}</b><span class="coord">{label}</span></li>
      ))}
    </ul>
  </section>

  <section class="shell" id="devlog-stream">
    <div class="section-head">
      <span class="coord">03 / DEVLOG</span>
      <h2>Build log</h2>
    </div>

    {rendered.length === 0 ? (
      <p class="empty coord">// no devlogs yet for this project</p>
    ) : (
      <ul class="stream">
        {rendered.map(({ entry, Content }) => (
          <li class="entry" id={entry.id.replace(/\.md$/, "").replace(/\//g, "--")}>
            <div class="entry-meta coord">
              <time datetime={entry.data.date.toISOString()}>
                {entry.data.date.toISOString().slice(0, 10)}
              </time>
              {entry.data.tags.length > 0 && (
                <div class="ticker-viewport" aria-hidden="true">
                  <ul class="tags">
                    {[...padForTicker(entry.data.tags), ...padForTicker(entry.data.tags)].map((t: string | null) =>
                      t === null ? <li class="ticker-gap" /> : <li>{t}</li>
                    )}
                  </ul>
                </div>
              )}
            </div>
            <h3>{entry.data.title}</h3>
            <div class="entry-body">
              <Content />
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: clamp(0.75rem, 2vw, 1.5rem);
    padding: 0.9rem clamp(1rem, 3vw, 1.75rem);
    position: relative; z-index: 3;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    border: var(--border);
    border-radius: var(--radius-panel);
    box-shadow: var(--panel-highlight), var(--panel-shadow);
  }
  .mark { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); color: var(--ink); letter-spacing: 0.02em; }
  .mark-dot { color: var(--accent); }
  .nav ul { display: flex; gap: 1.5rem; list-style: none; }
  .nav ul a { color: var(--ink-dim); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.1em; }
  .nav ul a:hover { color: var(--accent); }
  @media (max-width: 620px) {
    .nav ul { display: none; }
  }

  .project-hero { position: relative; padding-top: clamp(2rem, 5vw, 4rem); padding-bottom: 2rem; }
  .project-hero-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg,
      color-mix(in oklch, var(--bg) 97%, transparent) 0%,
      color-mix(in oklch, var(--bg) 94%, transparent) 48%,
      color-mix(in oklch, var(--bg) 65%, transparent) 65%,
      transparent 86%);
    mask-image: linear-gradient(180deg, transparent 0%, black 15%, black 82%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 15%, black 82%, transparent 100%);
  }
  .project-hero-inner { position: relative; z-index: 2; }
  .project-hero h1 { font-size: var(--step-3); margin: 0.5rem 0 1rem; }
  .lede { max-width: var(--measure); color: var(--ink-dim); font-size: var(--step-1); }
  .project-hero-inner .ticker-viewport { margin-top: 1.5rem; }
  .stack { list-style: none; }
  .stack li { font-size: var(--step--1); color: var(--ink-faint); border: var(--border); padding: 0.1rem 0.5rem; border-radius: var(--radius); white-space: nowrap; }
  .project-links { display: flex; gap: 1.5rem; margin: 1.5rem 0 0.5rem; }
  .project-links a { color: var(--accent); }

  .mp-demo-shell {
    margin-top: 2rem; padding: 1.5rem;
    border: var(--border); border-radius: var(--radius-panel);
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--panel-highlight), var(--panel-shadow);
  }
  .mp-demo-kicker { display: block; margin-bottom: 1rem; }

  .section-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2rem; }
  .section-head h2 { font-size: var(--step-2); }

  .tiers { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; max-width: var(--measure); margin-bottom: 2.5rem; }
  .tier { display: flex; gap: 1.25rem; align-items: baseline; }
  .tier-n { color: var(--accent); flex-shrink: 0; }
  .tier h3 { font-size: var(--step-0); margin-bottom: 0.25rem; }
  .tier p { color: var(--ink-dim); font-size: var(--step--1); }

  .stat-line {
    display: flex; flex-wrap: wrap; gap: 0; list-style: none;
    border: var(--border); border-radius: var(--radius-panel); overflow: hidden;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--panel-highlight), var(--panel-shadow);
  }
  .stat-line li {
    flex: 1 1 auto; min-width: 8rem; padding: 0.9rem 1.2rem;
    display: flex; flex-direction: column; gap: 0.15rem;
    border-right: var(--border);
  }
  .stat-line li:last-child { border-right: none; }
  .stat-line b { font-size: var(--step-1); color: var(--accent); }

  .stream { list-style: none; display: flex; flex-direction: column; gap: var(--gap); }
  .entry {
    border: var(--border); border-radius: var(--radius-panel); background: var(--bg-glass);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--panel-highlight), var(--panel-shadow);
    padding: 1.5rem;
  }
  .entry-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
  .entry-meta .tags { list-style: none; }
  .entry-meta .tags li { border: var(--border); padding: 0.05rem 0.4rem; border-radius: var(--radius); white-space: nowrap; }
  .entry h3 { font-size: var(--step-1); margin-bottom: 0.75rem; }
  .entry-body { max-width: var(--measure); color: var(--ink-dim); }
  .entry-body :global(a) { color: var(--accent); }
  .entry-body :global(pre) {
    background: var(--bg-sunken); border: var(--border); border-radius: var(--radius);
    padding: 1rem; overflow-x: auto;
  }

  .empty { display: block; padding: 2rem; border: 1px dashed var(--hairline); border-radius: var(--radius); }

  /* ── MouthpieceDemoScope ─────────────────────────────────────────── */
  .mp-demo { display: flex; flex-direction: column; gap: 1rem; }
  .mp-demo-input {
    background: var(--bg-sunken); border: var(--border); border-radius: var(--radius);
    color: var(--ink); font-family: var(--font-mono); font-size: var(--step-0);
    padding: 0.6rem 0.9rem;
  }
  .mp-demo-input:focus { outline: none; border-color: var(--accent); }
  .mp-demo-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .mp-chip {
    background: none; border: var(--border); border-radius: var(--radius);
    color: var(--ink-dim); font-family: var(--font-mono); font-size: var(--step--1);
    padding: 0.35rem 0.75rem; cursor: pointer; transition: color 0.15s, border-color 0.15s;
  }
  .mp-chip:hover { color: var(--accent); border-color: var(--accent); }
  .mp-chip.on { color: var(--bg); background: var(--accent); border-color: var(--accent); }
  .mp-demo-empty { color: var(--ink-faint); }

  .mp-demo-scope { width: 100%; height: 90px; display: block; }

  .mp-demo-tiles { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .mp-tile {
    border: var(--border); border-radius: var(--radius); background: var(--bg-sunken);
    padding: 0.5rem 0.75rem; min-width: 6rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .mp-tile.natural { border-style: solid; border-color: var(--accent); }
  .mp-tile:not(.natural) { border-style: dashed; }
  .mp-tile.playing { box-shadow: 0 0 0 2px var(--accent-glow); }
  .mp-tile-label { font-size: var(--step-0); color: var(--ink); letter-spacing: 0.02em; }
  .mp-tile-source { margin-top: 0.15rem; }
  .mp-tile-speaker { color: var(--ink-faint); }
</style>
