---
// Part datasheet: one federated project. Datasheet family on the Profile layout
// (no visualizer, no player). Sections: spec table, the project's own custom hero
// if it ships one (io-page page/ bundle, see AGENTS.md), and its build log.
import { getCollection, render } from "astro:content";
import Profile from "../../layouts/Profile.astro";
import { identity as id, loadParts, domains } from "../../data/profile";
import { isListed } from "../../lib/listing";
import "../../styles/catalogue.css";
import "../../styles/custom-page-host.css";

export async function getStaticPaths() {
  const parts = await loadParts();
  const listed = parts.filter(isListed);
  return parts.map((p) => {
    const i = listed.indexOf(p);
    return {
      params: { slug: p.slug },
      props: { part: p, prev: i > 0 ? listed[i - 1] : undefined, next: i >= 0 ? listed[i + 1] : undefined },
    };
  });
}

const { part: p, prev, next } = Astro.props;

const devlogs = (await getCollection("devlogs", (e) => e.data.project === p.slug && !e.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const rendered = await Promise.all(devlogs.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));

// Custom hero: mounted by hand below. Astro's client:* directives need a static
// import, and a glob-derived component doesn't qualify ([NoMatchingImport]).
const customPageLoaders = import.meta.glob("../../generated/projects/*/entry.tsx");
const hasCustomPage = `../../generated/projects/${p.slug}/entry.tsx` in customPageLoaders;
const devlogSummaries = devlogs.map((e) => ({ id: e.id, title: e.data.title, date: e.data.date.toISOString(), tags: e.data.tags }));
const { ref, domains: _d, logs: _l, lastLog: _ll, ...project } = p; // the contract's `project` mirrors meta.json
const accentStyle = p.accent ? `--accent-l:${p.accent[0]};--accent-c:${p.accent[1]};--accent-h:${p.accent[2]};` : "";

const ymd = (d: Date) => d.toISOString().slice(0, 10);
const anchor = (entryId: string) => entryId.replace(/\.md$/, "").replace(/\//g, "--");
const pinLabels = p.domains.map((d) => domains.find((x) => x.id === d)?.label).filter(Boolean);
const host = (u: string) => u.replace(/^https?:\/\//, "").replace(/\/$/, "");
let n = 1;
const fonts = `https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;600;700${hasCustomPage ? "&family=Chakra+Petch:wght@400;500;600;700" : ""}&display=swap`;
---
<Profile title={`${p.title} — ${id.name}`} description={p.tagline} fonts={fonts}>
  <a class="skip" href="#main">Skip to content</a>
  <div class="sheet">
    <header class="top">
      <a href="/" class="logo" aria-label="Homepage">KV</a>
      <nav aria-label="Primary" class="mono">
        <a href="/">Home</a><a href="/projects">Projects</a><a href="/devlog">Build log</a><a href="/cv">CV</a>
      </nav>
    </header>
    <main id="main">
      <header class="head">
        <p class="eyebrow mono"><a href="/projects">Catalogue</a> / {ref}</p>
        <div class="titlerow">
          <h1>{p.title}</h1>
          <span class={`badge ${p.status}`}>{p.status}</span>
        </div>
        <p class="lede">{p.tagline}</p>
        {p.url && <p class="site"><a class="go mono" href={p.url}>Visit the project site →</a></p>}
      </header>

      <section class="block" aria-labelledby="s-h">
        <h2 id="s-h"><span class="n mono">{n++}</span>Specifications</h2>
        <dl class="spec">
          <dt>Ref</dt><dd class="mono">{ref}</dd>
          <dt>Status</dt><dd>{p.status}</dd>
          <dt>Stack</dt><dd class="mono">{p.stack.join(" · ")}</dd>
          {pinLabels.length > 0 && <><dt>Pins</dt><dd class="mono">{pinLabels.map((l) => <span class="pinchip"><span class="pin" aria-hidden="true"></span> {l}</span>)}</dd></>}
          <dt>Source</dt><dd class="mono"><a href={p.repo}>{host(p.repo)}</a></dd>
          {p.demo && <><dt>Demo</dt><dd class="mono"><a href={p.demo}>{host(p.demo)}</a></dd></>}
          {p.url && <><dt>Own site</dt><dd class="mono"><a href={p.url}>{host(p.url)}</a></dd></>}
          <dt>Build log</dt><dd class="mono">{devlogs.length ? `${devlogs.length} entries, latest ${ymd(devlogs[0].data.date)}` : "none yet"}</dd>
        </dl>
      </section>

      {hasCustomPage && (
        <section class="screenblock" aria-labelledby="f-h">
          <h2 id="f-h" class="block-h"><span class="n mono">{n++}</span>Front panel <span class="note mono">made by the project itself</span></h2>
          <div class="custom-screen" style={accentStyle}>
            <div id="project-custom-root" data-slug={p.slug} data-project={JSON.stringify(project)} data-devlogs={JSON.stringify(devlogSummaries)}></div>
          </div>
        </section>
      )}

      <section class="block" id="devlog-stream" aria-labelledby="l-h">
        <h2 id="l-h"><span class="n mono">{n++}</span>Build log</h2>
        {rendered.length === 0 ? (
          <p class="mono">No entries yet for this part.</p>
        ) : (
          <>
            <ol class="toc mono">
              {rendered.map(({ entry }) => (
                <li><a href={`#${anchor(entry.id)}`}><time datetime={entry.data.date.toISOString()}>{ymd(entry.data.date)}</time> {entry.data.title}</a></li>
              ))}
            </ol>
            {rendered.map(({ entry, Content }, i) => (
              <article class="log" id={anchor(entry.id)} aria-labelledby={`${anchor(entry.id)}-t`}>
                <p class="meta mono">
                  <span>REV {rendered.length - i}</span>
                  <time datetime={entry.data.date.toISOString()}>{ymd(entry.data.date)}</time>
                  {entry.data.tags.length > 0 && <span class="tags">{entry.data.tags.join(" · ")}</span>}
                </p>
                <h3 id={`${anchor(entry.id)}-t`}>{entry.data.title}</h3>
                <div class="prose"><Content /></div>
              </article>
            ))}
          </>
        )}
      </section>

      {(prev || next) && (
        <nav class="block pager mono" aria-label="Other parts">
          {prev ? <a href={prev.url ?? `/projects/${prev.slug}`} rel="prev">← {prev.ref} {prev.title}</a> : <span></span>}
          {next && <a href={next.url ?? `/projects/${next.slug}`} rel="next">{next.ref} {next.title} →</a>}
        </nav>
      )}
    </main>
  </div>
</Profile>

{/* Must stay unconditional: Astro only bundles a <script> it finds statically. */}
<script>
  (async () => {
    const root = document.getElementById("project-custom-root");
    if (!root) return;
    const loaders = import.meta.glob("../../generated/projects/*/entry.tsx") as Record<
      string,
      () => Promise<{ default: (props: { project: unknown; devlogs: unknown }) => any }>
    >;
    const load = loaders[`../../generated/projects/${root.dataset.slug}/entry.tsx`];
    if (!load) return;
    const [{ default: Component }, { createElement }, { createRoot }] = await Promise.all([
      load(),
      import("react"),
      import("react-dom/client"),
    ]);
    const project = JSON.parse(root.dataset.project ?? "null");
    const devlogs = JSON.parse(root.dataset.devlogs ?? "[]");
    createRoot(root).render(createElement(Component, { project, devlogs }));
  })();
</script>

<style>
  .titlerow { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; }
  .titlerow .badge { font-size: 13px; }
  .eyebrow a { color: inherit; }
  .site { margin: 18px 0 0; }
  .go { display: inline-block; background: var(--ds-hi); color: var(--ds-ink); border: 2px solid var(--ds-ink); box-shadow: 4px 4px 0 var(--ds-ink); padding: 8px 14px; font-weight: 700; text-decoration: none; }
  .go:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 var(--ds-ink); }

  .spec { display: grid; grid-template-columns: 8em 1fr; gap: 8px 16px; margin: 0; }
  .spec dt { font-weight: 700; }
  .spec dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .pinchip { display: inline-flex; align-items: center; gap: 6px; margin-right: 14px; white-space: nowrap; }

  .screenblock { border-bottom: 2px solid var(--ds-ink); }
  .block-h { padding: 20px clamp(16px, 3vw, 28px) 0; }
  .note { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--ds-dim); font-size: 12px; }
  .custom-screen { border-top: 2px solid var(--ds-ink); border-bottom: 0; min-height: 12rem; }

  .toc { list-style: none; padding: 0; margin: 0 0 8px; font-size: 13px; columns: 2 22rem; column-gap: 24px; }
  .toc li { break-inside: avoid; padding: 2px 0; }
  .toc a { color: var(--ds-ink); }
  .toc time { color: var(--ds-dim); margin-right: 6px; }
  .log { border-top: 1px solid var(--ds-rule); padding: 20px 0 4px; scroll-margin-top: 12px; }
  .log:target { background: linear-gradient(90deg, var(--ds-hi), transparent 40%); }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0; font-size: 12px; color: var(--ds-dim); text-transform: uppercase; letter-spacing: .06em; }
  .meta span:first-child { background: var(--ds-ink); color: #fff; padding: 0 6px; }
  .log h3 { font-size: 22px; line-height: 1.15; margin: 6px 0 10px; font-weight: 800; }

  .prose { max-width: 72ch; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 12px; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { font-size: 16px; text-transform: none; letter-spacing: 0; margin: 20px 0 8px; display: block; font-weight: 800; }
  .prose :global(img) { max-width: 100%; height: auto; border: 2px solid var(--ds-ink); }
  .prose :global(code) { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: .88em; background: #efeee8; padding: 1px 4px; overflow-wrap: anywhere; }
  .prose :global(pre) { background: #111; color: #f2f2ee; padding: 14px; overflow-x: auto; font-size: 13px; line-height: 1.5; }
  .prose :global(pre code) { background: none; padding: 0; overflow-wrap: normal; color: inherit; }
  .prose :global(blockquote) { margin: 0 0 12px; padding-left: 14px; border-left: 4px solid var(--ds-hi); }
  .prose :global(table) { border-collapse: collapse; display: block; overflow-x: auto; margin: 0 0 12px; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--ds-rule); padding: 4px 8px; text-align: left; }

  .pager { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 14px; }
  .pager a { color: var(--ds-ink); font-weight: 600; }
  @media (max-width: 640px) {
    .spec { grid-template-columns: 1fr; gap: 0; }
    .spec dd { margin-bottom: 10px; }
  }
</style>
