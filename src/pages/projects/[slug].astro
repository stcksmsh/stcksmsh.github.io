---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.data.slug },
    props: { project: p.data },
  }));
}

const { project } = Astro.props;

const allDevlogs = await getCollection(
  "devlogs",
  (entry) => entry.data.project === project.slug && !entry.data.draft
);
const devlogs = allDevlogs.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const rendered = await Promise.all(
  devlogs.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const nav = [
  ["projects", "/#work"],
  ["music", "/#sound"],
  ["devlog", "/#devlog"],
  ["cv", "/cv"],
];
---
<Base title={project.title} description={project.tagline} accent={project.accent}>
  <nav class="shell nav">
    <a href="/" class="mark">KOSTA<span class="mark-dot">.</span>VUKIĆEVIĆ</a>
    <ul>
      {nav.map(([label, href]) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>

  <header class="shell project-hero">
    <div class="project-hero-scrim"></div>
    <div class="project-hero-inner">
      <span class="coord">{project.status}</span>
      <h1>{project.title}</h1>
      <p class="lede">{project.tagline}</p>
      <ul class="stack">
        {project.stack.map((s: string) => <li>{s}</li>)}
      </ul>
      <div class="project-links">
        <a href={project.repo}>repo →</a>
        {project.demo && <a href={project.demo}>demo →</a>}
      </div>
    </div>
  </header>

  <section class="shell" id="devlog-stream">
    <div class="section-head">
      <span class="coord">02 / DEVLOG</span>
      <h2>Build log</h2>
    </div>

    {rendered.length === 0 ? (
      <p class="empty coord">// no devlogs yet for this project</p>
    ) : (
      <ul class="stream">
        {rendered.map(({ entry, Content }) => (
          <li class="entry" id={entry.id.replace(/\.md$/, "").replace(/\//g, "--")}>
            <div class="entry-meta coord">
              <time datetime={entry.data.date.toISOString()}>
                {entry.data.date.toISOString().slice(0, 10)}
              </time>
              {entry.data.tags.length > 0 && (
                <ul class="tags">
                  {entry.data.tags.map((t: string) => <li>{t}</li>)}
                </ul>
              )}
            </div>
            <h3>{entry.data.title}</h3>
            <div class="entry-body">
              <Content />
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: clamp(0.75rem, 2vw, 1.5rem);
    padding: 0.9rem clamp(1rem, 3vw, 1.75rem);
    position: relative; z-index: 3;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    border: var(--border);
    border-radius: var(--radius-panel);
    box-shadow: var(--panel-highlight), var(--panel-shadow);
  }
  .mark { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); color: var(--ink); letter-spacing: 0.02em; }
  .mark-dot { color: var(--accent); }
  .nav ul { display: flex; gap: 1.5rem; list-style: none; }
  .nav ul a { color: var(--ink-dim); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.1em; }
  .nav ul a:hover { color: var(--accent); }
  @media (max-width: 620px) {
    .nav ul { display: none; }
  }

  .project-hero { position: relative; padding-top: clamp(2rem, 5vw, 4rem); padding-bottom: 2rem; }
  .project-hero-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg,
      color-mix(in oklch, var(--bg) 97%, transparent) 0%,
      color-mix(in oklch, var(--bg) 94%, transparent) 48%,
      color-mix(in oklch, var(--bg) 65%, transparent) 65%,
      transparent 86%);
    /* Feather top/bottom so the scrim's own box doesn't read as a hard-
       edged rectangle against the artwork above/below it. */
    mask-image: linear-gradient(180deg, transparent 0%, black 15%, black 82%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 15%, black 82%, transparent 100%);
  }
  .project-hero-inner { position: relative; z-index: 2; }
  .project-hero h1 { font-size: var(--step-3); margin: 0.5rem 0 1rem; }
  .lede { max-width: var(--measure); color: var(--ink-dim); font-size: var(--step-1); }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.5rem; }
  .stack li { font-size: var(--step--1); color: var(--ink-faint); border: var(--border); padding: 0.1rem 0.5rem; border-radius: var(--radius); }
  .project-links { display: flex; gap: 1.5rem; margin: 1.5rem 0 0.5rem; }
  .project-links a { color: var(--accent); }

  .section-head { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 2rem; }
  .section-head h2 { font-size: var(--step-2); }

  .stream { list-style: none; display: flex; flex-direction: column; gap: var(--gap); }
  .entry {
    border: var(--border); border-radius: var(--radius-panel); background: var(--bg-glass);
    backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--panel-highlight), var(--panel-shadow);
    padding: 1.5rem;
  }
  .entry-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
  .entry-meta .tags { list-style: none; display: flex; gap: 0.4rem; }
  .entry-meta .tags li { border: var(--border); padding: 0.05rem 0.4rem; border-radius: var(--radius); }
  .entry h3 { font-size: var(--step-1); margin-bottom: 0.75rem; }
  .entry-body { max-width: var(--measure); color: var(--ink-dim); }
  .entry-body :global(a) { color: var(--accent); }
  .entry-body :global(pre) {
    background: var(--bg-sunken); border: var(--border); border-radius: var(--radius);
    padding: 1rem; overflow-x: auto;
  }

  .empty { display: block; padding: 2rem; border: 1px dashed var(--hairline); border-radius: var(--radius); }
</style>
